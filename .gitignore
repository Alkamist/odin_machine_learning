# Vendored CUDA import libraries (also matched by *.lib above; listed so the
# whole directory stays ignored if a .dll is ever dropped alongside them)
backends/cuda/lib/
backends/cuda/bindings/lib/

# Model weights and checkpoints
*.safetensors
*.gguf

# Auto-downloaded by the examples (see examples/fetch/fetch.odin). Neither the
# tokenizer.json files nor the idx-ubyte.gz files are covered by the globs
# above, so match the whole trees. *.part is fetch.odin's in-progress download.
examples/llm_chat/data/
examples/mnist/data/
*.part

# Tooling
ols.json
.claude/

# Editors
.vs/
.vscode/
.idea/
*.swp

