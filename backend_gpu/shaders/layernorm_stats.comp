// Per-row mean and rstd, written into two small buffers indexed by row.
// Forward layernorm doesn't save these; backward needs them, and recomputing
// them once is cheaper than threading them through the activation pool.
//
// One workgroup per row, BLOCK threads, shared-memory reduction.
#version 450

#define BLOCK 256
#define EPSILON 1e-5

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly  buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer M { float mean_out[]; };
layout(set = 0, binding = 2) writeonly buffer R { float rstd_out[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float ssum[BLOCK];
shared float ssum2[BLOCK];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    float s  = 0.0;
    float s2 = 0.0;
    uint base = row * p.size;
    for (uint i = tid; i < p.size; i += BLOCK) {
        float v = x[base + i];
        s  += v;
        s2 += v * v;
    }
    ssum[tid]  = s;
    ssum2[tid] = s2;
    barrier();

    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) {
            ssum[tid]  += ssum[tid + stride];
            ssum2[tid] += ssum2[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        float n = float(p.size);
        float m = ssum[0]  / n;
        float v = ssum2[0] / n - m * m;
        mean_out[row] = m;
        rstd_out[row] = inversesqrt(v + EPSILON);
    }
}
