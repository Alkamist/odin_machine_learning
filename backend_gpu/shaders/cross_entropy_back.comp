// Backward of `cross_entropy`. Reads precomputed probabilities (from
// forward) plus targets and the per-sample upstream gradient:
//   dx[sample, i] += (prob[sample, i] - (i == target)) * dy[sample]
// Thread per (sample, class). No reduction, no race; accumulates into
// dx because cross_entropy may not be the head of the backward sweep.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer P  { float probs[];   };
layout(set = 0, binding = 1) readonly buffer T  { uint  targets[]; };
layout(set = 0, binding = 2) readonly buffer DY { float dy[];      };
layout(set = 0, binding = 3)          buffer DX { float dx[];      };

layout(push_constant) uniform Params {
    uint count;
    uint class_size;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = p.count * p.class_size;
    if (idx >= total) return;

    uint row  = idx / p.class_size;
    uint i    = idx % p.class_size;
    float ind = (i == targets[row]) ? 1.0 : 0.0;
    dx[idx] += (probs[idx] - ind) * dy[row];
}
