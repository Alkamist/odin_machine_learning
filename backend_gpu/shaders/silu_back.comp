// dx += dy * (sigmoid(x) + x*sigmoid(x)*(1-sigmoid(x))). Thread per element.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X  { float x[];  };
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 2)          buffer DX { float dx[]; };
layout(push_constant) uniform Params { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float xv = x[i];
    float s  = 1.0 / (1.0 + exp(-xv));
    float g  = s + xv * s * (1.0 - s);
    dx[i] += dy[i] * g;
}
