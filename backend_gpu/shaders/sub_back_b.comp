// b.grad[j] -= sum_i dy[i*n_b + j]. Thread per b element, reduces over stride.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer DY   { float dy[];   };
layout(set = 0, binding = 1)          buffer DA_B { float da_b[]; };
layout(push_constant) uniform Params { uint n_b; uint stride; } p;
void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= p.n_b) return;
    float acc = 0.0;
    for (uint i = 0; i < p.stride; ++i) {
        acc += dy[i * p.n_b + j];
    }
    da_b[j] -= acc;
}
