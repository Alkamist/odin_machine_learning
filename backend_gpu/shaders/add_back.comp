// Backward of `add`. Same-shape inputs only (matches gpu.add). Both input
// gradients accumulate the output gradient elementwise.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer DA_A { float da_a[]; };
layout(set = 0, binding = 1)          buffer DA_B { float da_b[]; };
layout(set = 0, binding = 2) readonly buffer DY   { float dy[];   };

layout(push_constant) uniform Params {
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float v = dy[i];
    da_a[i] += v;
    da_b[i] += v;
}
