// y[i, o] = sum_k x[i, k] * w[o, k]
//
// Layout (matches CPU `linear`):
//   x: [M=count,       K=input_size]   row-major
//   w: [N=output_size, K=input_size]   row-major
//   y: [M=count,       N=output_size]  row-major
//
// Tiled GEMM with shared-memory K-tiles + register-tile accumulation:
//   - Each workgroup computes a TILE_M × TILE_N output block.
//   - 16×16 = 256 threads per WG, each owning a TM × TN sub-tile.
//   - K loop in TILE_K-wide steps; A and B tiles staged through shared mem.
//
// Reads from shared memory (one barrier per K-tile) instead of re-reading
// global per-element. Total flops/byte goes from ~0.5 (naive) to ~16 here,
// which is the win over the naive kernel.
#version 450

#define TILE_M 32
#define TILE_N 64
#define TILE_K 16
#define TM     4
#define TN     4
#define WG_X   8    // = TILE_M / TM
#define WG_Y   16   // = TILE_N / TN
#define WG     128  // = WG_X * WG_Y

layout(local_size_x = WG_X, local_size_y = WG_Y) in;

layout(set = 0, binding = 0) readonly  buffer X { float x[]; };
layout(set = 0, binding = 1) readonly  buffer W { float w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Params {
    uint M;  // count
    uint K;  // input_size
    uint N;  // output_size
} p;

// +1 padding on the K dim breaks the 32-way bank conflict on the inner
// reads `sx[tx*TM + a][kk]` and `sw[ty*TN + b][kk]`.
shared float sx[TILE_M][TILE_K + 1];
shared float sw[TILE_N][TILE_K + 1];

void main() {
    uint wg_i = gl_WorkGroupID.x;
    uint wg_o = gl_WorkGroupID.y;
    uint tx   = gl_LocalInvocationID.x;
    uint ty   = gl_LocalInvocationID.y;
    uint tid  = ty * WG_X + tx;

    uint i_base = wg_i * TILE_M + tx * TM;  // first row of this thread's sub-tile in y
    uint o_base = wg_o * TILE_N + ty * TN;  // first col of this thread's sub-tile in y

    float acc[TM][TN];
    for (int a = 0; a < TM; ++a)
        for (int b = 0; b < TN; ++b)
            acc[a][b] = 0.0;

    uint k_tiles = (p.K + TILE_K - 1u) / TILE_K;

    for (uint kt = 0u; kt < k_tiles; ++kt) {
        // Cooperatively load tile of x: [TILE_M, TILE_K] = 1024 floats
        // distributed across 256 threads → 4 loads per thread.
        for (uint l = 0u; l < (TILE_M * TILE_K) / WG; ++l) {
            uint idx = tid + l * WG;
            uint row = idx / TILE_K;
            uint col = idx % TILE_K;
            uint gi  = wg_i * TILE_M + row;
            uint gk  = kt   * TILE_K + col;
            sx[row][col] = (gi < p.M && gk < p.K) ? x[gi * p.K + gk] : 0.0;
        }
        // Same for w: [TILE_N, TILE_K].
        for (uint l = 0u; l < (TILE_N * TILE_K) / WG; ++l) {
            uint idx = tid + l * WG;
            uint row = idx / TILE_K;
            uint col = idx % TILE_K;
            uint go  = wg_o * TILE_N + row;
            uint gk  = kt   * TILE_K + col;
            sw[row][col] = (go < p.N && gk < p.K) ? w[go * p.K + gk] : 0.0;
        }
        barrier();

        // Inner product over the K-tile. Each thread reads TM rows of sx and
        // TN rows of sw (per-kk slice), accumulates TM×TN partial sums.
        for (uint kk = 0u; kk < TILE_K; ++kk) {
            float xreg[TM];
            float wreg[TN];
            for (int a = 0; a < TM; ++a) xreg[a] = sx[tx * TM + a][kk];
            for (int b = 0; b < TN; ++b) wreg[b] = sw[ty * TN + b][kk];
            for (int a = 0; a < TM; ++a)
                for (int b = 0; b < TN; ++b)
                    acc[a][b] += xreg[a] * wreg[b];
        }
        barrier();
    }

    // Store accumulators back to y.
    for (int a = 0; a < TM; ++a) {
        for (int b = 0; b < TN; ++b) {
            uint gi = i_base + uint(a);
            uint go = o_base + uint(b);
            if (gi < p.M && go < p.N) {
                y[gi * p.N + go] = acc[a][b];
            }
        }
    }
}
