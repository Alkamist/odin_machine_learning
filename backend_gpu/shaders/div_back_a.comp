// a.grad[i] += dy[i] / b[i % n_b]. Thread per output.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer B    { float b[];    };
layout(set = 0, binding = 1) readonly buffer DY   { float dy[];   };
layout(set = 0, binding = 2)          buffer DA_A { float da_a[]; };
layout(push_constant) uniform Params { uint n; uint n_b; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    da_a[i] += dy[i] / b[i % p.n_b];
}
