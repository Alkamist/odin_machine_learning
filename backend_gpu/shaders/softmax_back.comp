// Per-row softmax backward, matching CPU `softmax_backward`.
//   y:  [count, size]   forward output (probabilities)
//   dy: [count, size]   upstream gradient
//   dx: [count, size]   input gradient (accumulate)
//
// Math: dx[i] += y[i] * (dy[i] - sum_j y[j] * dy[j])
//
// One workgroup per row. Reduction computes <y, dy> for the row, then
// each thread writes its slice of dx with the per-row dot subtracted.
#version 450

#define WG 256

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly  buffer Y  { float y[];  };
layout(set = 0, binding = 1) readonly  buffer DY { float dy[]; };
layout(set = 0, binding = 2)           buffer DX { float dx[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float partial[WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;
    uint off = row * p.size;

    float s = 0.0;
    for (uint i = tid; i < p.size; i += WG) s += y[off + i] * dy[off + i];
    partial[tid] = s;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float row_dot = partial[0];
    barrier();

    for (uint i = tid; i < p.size; i += WG) {
        dx[off + i] += y[off + i] * (dy[off + i] - row_dot);
    }
}
