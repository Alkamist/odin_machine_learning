// Bf16 softmax backward. One workgroup per row; size must be even so each
// row starts at a pair boundary. RMW dx in packed-uint pairs from each
// workgroup's owned row — no inter-workgroup race.
#version 450

#define WG 256

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly buffer Y  { uint y[];  };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[]; };
layout(set = 0, binding = 2)          buffer DX { uint dx[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float partial[WG];

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}
float load_half(uint buf_pair, uint shift) { return bf16_expand((buf_pair >> shift) & 0xffffu); }

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint pair_count = p.size >> 1u;
    uint pair_base  = (row * p.size) >> 1u;

    float s = 0.0;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint yp  = y [pair_base + pi];
        uint dyp = dy[pair_base + pi];
        s += load_half(yp, 0u)  * load_half(dyp, 0u);
        s += load_half(yp, 16u) * load_half(dyp, 16u);
    }
    partial[tid] = s;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float row_dot = partial[0];
    barrier();

    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint yp  = y [pair_base + pi];
        uint dyp = dy[pair_base + pi];
        uint dxp = dx[pair_base + pi];

        float y0  = load_half(yp, 0u);
        float y1  = load_half(yp, 16u);
        float dy0 = load_half(dyp, 0u);
        float dy1 = load_half(dyp, 16u);

        float lo_v = load_half(dxp, 0u)  + y0 * (dy0 - row_dot);
        float hi_v = load_half(dxp, 16u) + y1 * (dy1 - row_dot);

        dx[pair_base + pi] = (bf16_round(hi_v) << 16) | bf16_round(lo_v);
    }
}
