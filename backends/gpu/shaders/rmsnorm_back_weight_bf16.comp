// Bf16 rmsnorm backward (weight): dW[i] += sum_c (x[c,i]*rstd[c]) * dy[c,i].
// Thread per dW pair; size must be even so each thread owns a whole packed
// uint. Inner loop reduces across rows for each pair.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X  { uint  x[];    };
layout(set = 0, binding = 1) readonly buffer DY { uint  dy[];   };
layout(set = 0, binding = 2) readonly buffer R  { float rstd[]; };
layout(set = 0, binding = 3)          buffer DW { uint  dw[];   };
layout(push_constant) uniform Params { uint count; uint size; uint pair_count; } p;

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}

void main() {
    uint pi = gl_GlobalInvocationID.x;
    if (pi >= p.pair_count) return;

    float acc0 = 0.0;
    float acc1 = 0.0;
    uint  size_pairs = p.size >> 1u;
    for (uint c = 0u; c < p.count; c++) {
        float r = rstd[c];
        uint  base_pair = c * size_pairs;
        uint xp  = x [base_pair + pi];
        uint dyp = dy[base_pair + pi];
        float x0 = bf16_expand(xp & 0xffffu);
        float x1 = bf16_expand((xp >> 16) & 0xffffu);
        float d0 = bf16_expand(dyp & 0xffffu);
        float d1 = bf16_expand((dyp >> 16) & 0xffffu);
        acc0 += x0 * r * d0;
        acc1 += x1 * r * d1;
    }

    uint dwp = dw[pi];
    uint lo = bf16_round(bf16_expand(dwp & 0xffffu)         + acc0);
    uint hi = bf16_round(bf16_expand((dwp >> 16) & 0xffffu) + acc1);
    dw[pi] = (hi << 16) | lo;
}
