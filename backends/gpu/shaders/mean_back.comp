// Backward of `mean`: dx[row*size + i] += dy[row] / size.
// One thread per input element; no reduction, no race.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 1)          buffer DX { float dx[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = p.count * p.size;
    if (idx >= total) return;
    uint row = idx / p.size;
    dx[idx] += dy[row] / float(p.size);
}
