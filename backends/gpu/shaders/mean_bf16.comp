// Bf16 forward of `mean`: y[row] = (1/size) * sum_i x[row*size + i].
// One workgroup per row; threads read packed bf16 pairs out of x; partial f32
// reduction in shared memory; thread 0 stores back as bf16.
#version 450

#define BLOCK 256

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly  buffer X { uint  x[]; };
layout(set = 0, binding = 1)           buffer Y { uint  y[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float partial[BLOCK];

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

uint bf16_round(float v) {
    uint bits = floatBitsToUint(v);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

uint load_bf16(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (x[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;
    uint base = row * p.size;

    float s = 0.0;
    for (uint i = tid; i < p.size; i += BLOCK) {
        s += bf16_expand(load_bf16(base + i));
    }
    partial[tid] = s;
    barrier();

    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }

    if (tid == 0u) {
        uint pair_index = row >> 1u;
        uint shift      = (row & 1u) * 16u;
        uint stored     = bf16_round(partial[0] / float(p.size));
        // Each output bf16 element lands in y[row/2]; threads from different
        // workgroups can target the same pair, so use atomics for the half-RMW.
        uint mask    = 0xffffu << shift;
        uint payload = stored << shift;
        uint cur, nxt;
        do {
            cur = y[pair_index];
            nxt = (cur & ~mask) | payload;
        } while (atomicCompSwap(y[pair_index], cur, nxt) != cur);
    }
}
