// Backward of rmsnorm w.r.t. input. RMSNorm is layernorm with no mean
// term, so dnorm_mean drops out:
//
//   norm[c,i]       = x[c,i] * rstd[c]
//   dnorm[c,i]      = w[i] * dy[c,i]
//   dnorm_norm_mean = (1/size) * sum_i (dnorm[c,i] * norm[c,i])
//   dx[c,i] += (dnorm[c,i] - norm[c,i] * dnorm_norm_mean) * rstd[c]
#version 450

#define BLOCK 256

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly buffer X  { float x[];    };
layout(set = 0, binding = 1) readonly buffer W  { float w[];    };
layout(set = 0, binding = 2) readonly buffer DY { float dy[];   };
layout(set = 0, binding = 3) readonly buffer R  { float rstd[]; };
layout(set = 0, binding = 4)          buffer DX { float dx[];   };

layout(push_constant) uniform Params {
    uint  count;
    uint  size;
    float weight_bias;
} p;

shared float s_dn_norm[BLOCK];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint  base = row * p.size;
    float r    = rstd[row];

    float pb = 0.0;
    for (uint i = tid; i < p.size; i += BLOCK) {
        float norm  = x[base + i] * r;
        float dnorm = (w[i] + p.weight_bias) * dy[base + i];
        pb += dnorm * norm;
    }
    s_dn_norm[tid] = pb;
    barrier();

    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_dn_norm[tid] += s_dn_norm[tid + stride];
        barrier();
    }

    float dnorm_norm_mean = s_dn_norm[0] / float(p.size);

    for (uint i = tid; i < p.size; i += BLOCK) {
        float norm  = x[base + i] * r;
        float dnorm = (w[i] + p.weight_bias) * dy[base + i];
        float g     = (dnorm - norm * dnorm_norm_mean) * r;
        dx[base + i] += g;
    }
}
