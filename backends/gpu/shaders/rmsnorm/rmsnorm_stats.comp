// Per-row rstd = 1 / sqrt(mean(x^2) + eps). RMSNorm has no mean term, so
// only one reduction is needed.
#version 450

#define BLOCK 256
#define EPSILON 1e-5

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly  buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer R { float rstd_out[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float ssum2[BLOCK];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    float s2 = 0.0;
    uint base = row * p.size;
    for (uint i = tid; i < p.size; i += BLOCK) {
        float v = x[base + i];
        s2 += v * v;
    }
    ssum2[tid] = s2;
    barrier();

    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) ssum2[tid] += ssum2[tid + stride];
        barrier();
    }

    if (tid == 0u) {
        rstd_out[row] = inversesqrt(ssum2[0] / float(p.size) + EPSILON);
    }
}
