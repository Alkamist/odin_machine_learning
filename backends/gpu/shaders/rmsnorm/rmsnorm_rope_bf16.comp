// Fused bf16 rmsnorm-with-weight + rope. Used by Gemma's q_norm/k_norm path:
// rmsnorm operates per-head (size = head_size), then rope rotates the first
// `rotate_pair_count` pairs within each head. One workgroup per (token, head)
// pair — the per-head sum-of-squares reduces inside the WG, then the same
// threads emit the normalized * weight values, applying the RoPE rotation
// inline. head_size must be even.
#version 450
#include "bf16.glsl"
#define WG 128
layout(local_size_x = WG) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params {
    uint  token_count;
    uint  head_count;
    uint  head_size;
    float eps;
    float base;
    uint  position_offset;
    uint  rotate_pair_count;
} p;

shared float partial[WG];

void main() {
    uint wg_id = gl_WorkGroupID.x;
    uint tid   = gl_LocalInvocationID.x;
    uint head  = wg_id % p.head_count;
    uint pos   = wg_id / p.head_count;

    uint pair_count = p.head_size >> 1u;
    uint base_pair  = (pos * p.head_count + head) * pair_count;

    float s2 = 0.0;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[base_pair + pi];
        float v0 = bf16_expand(xp & 0xffffu);
        float v1 = bf16_expand((xp >> 16) & 0xffffu);
        s2 += v0 * v0 + v1 * v1;
    }
    partial[tid] = s2;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float rstd = inversesqrt(partial[0] / float(p.head_size) + p.eps);
    barrier();

    float pos_f       = float(pos + p.position_offset);
    float head_size_f = float(p.head_size);
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[base_pair + pi];
        uint wp = w[pi];
        float n0 = bf16_expand(xp & 0xffffu)         * rstd * bf16_expand(wp & 0xffffu);
        float n1 = bf16_expand((xp >> 16) & 0xffffu) * rstd * bf16_expand((wp >> 16) & 0xffffu);

        float o0, o1;
        if (pi < p.rotate_pair_count) {
            float exponent = float(pi * 2u) / head_size_f;
            float theta    = pos_f / pow(p.base, exponent);
            float c_v      = cos(theta);
            float s_v      = sin(theta);
            o0 = n0 * c_v - n1 * s_v;
            o1 = n0 * s_v + n1 * c_v;
        } else {
            o0 = n0;
            o1 = n1;
        }
        y[base_pair + pi] = (bf16_round(o1) << 16) | bf16_round(o0);
    }
}
