// Rotary position embedding, matching CPU `ml.rope`.
//   in:  [token_count, head_count * head_size]
//   out: [token_count, head_count * head_size]
//
// For each (token, head, pair_index) triple the kernel rotates the (i*2,
// i*2+1) lane pair by angle theta = pos / base^(2i / head_size).
//
// One thread per pair. CPU caches sin/cos in a buffer; we recompute per
// thread — pow + sincos is cheap relative to the global memory writes.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer In  { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float y[]; };

layout(push_constant) uniform Params {
    uint  token_count;
    uint  head_count;
    uint  head_size;   // per-head dim, must be even
    float base;
    uint  position_offset;
} p;

void main() {
    uint gid     = gl_GlobalInvocationID.x;
    uint half_hs = p.head_size / 2u;
    uint total   = p.token_count * p.head_count * half_hs;
    if (gid >= total) return;

    uint pair_idx = gid % half_hs;
    uint hg       = gid / half_hs;
    uint head     = hg % p.head_count;
    uint pos      = hg / p.head_count;

    float exponent = float(pair_idx * 2u) / float(p.head_size);
    float theta    = float(pos + p.position_offset) / pow(p.base, exponent);
    float c_v      = cos(theta);
    float s_v      = sin(theta);

    uint head_offset = pos * p.head_count * p.head_size + head * p.head_size;
    uint i_lo = head_offset + pair_idx * 2u;
    uint i_hi = i_lo + 1u;

    float xv = x[i_lo];
    float yv = x[i_hi];
    y[i_lo] = xv * c_v - yv * s_v;
    y[i_hi] = xv * s_v + yv * c_v;
}
