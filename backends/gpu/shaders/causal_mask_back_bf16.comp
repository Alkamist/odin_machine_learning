// Bf16 backward of `causal_mask`. dx[idx] += dy[idx] only on the masked
// (lower-triangular) positions. One thread per input PAIR; packed RMW.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0)          buffer DX { uint dx[]; };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[]; };
layout(push_constant) uniform Params { uint total; uint T; uint pair_count; } p;

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

uint bf16_round(float v) {
    uint bits = floatBitsToUint(v);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

uint load_dy(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (dy[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;

    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint cur = dx[pair];
    uint cur_lo = cur & 0xffffu;
    uint cur_hi = (cur >> 16) & 0xffffu;
    uint lo = cur_lo;
    uint hi = cur_hi;

    if (i0 < p.total) {
        uint within = i0 % (p.T * p.T);
        uint t1 = within / p.T;
        uint t2 = within - t1 * p.T;
        if (t2 <= t1) {
            lo = bf16_round(bf16_expand(cur_lo) + bf16_expand(load_dy(i0)));
        }
    }
    if (i1 < p.total) {
        uint within = i1 % (p.T * p.T);
        uint t1 = within / p.T;
        uint t2 = within - t1 * p.T;
        if (t2 <= t1) {
            hi = bf16_round(bf16_expand(cur_hi) + bf16_expand(load_dy(i1)));
        }
    }

    dx[pair] = (hi << 16) | lo;
}
