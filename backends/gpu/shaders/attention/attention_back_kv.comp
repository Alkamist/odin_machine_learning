// Backward for K and V (per (kv_head, key) position).
// Inner loop iterates over the Q-head group sharing this kv_head, accumulating
// dK[kv_h, t_k] and dV[kv_h, t_k] across all q_heads in the group plus all t_q.
//
//   q:     [T, n_q_heads * D]
//   k,v:   [T, n_kv_heads * D]
//   d_o:   [T, n_q_heads * D]
//   lse:   [n_q_heads, T]
//   d_acc: [n_q_heads, T]
//   d_k,
//   d_v:   [T, n_kv_heads * D]   accumulating
//
// One workgroup per (kv_head, key). Each workgroup uniquely owns its
// (kv_h, t_k) slot in dK/dV so accumulation is race-free.
#version 450

#define WG 64

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly buffer Q  { float q_buf[]; };
layout(set = 0, binding = 1) readonly buffer K  { float k_buf[]; };
layout(set = 0, binding = 2) readonly buffer V  { float v_buf[]; };
layout(set = 0, binding = 3) readonly buffer DO { float dout[]; };
layout(set = 0, binding = 4) readonly buffer L  { float lse[]; };
layout(set = 0, binding = 5) readonly buffer DA { float d_acc[]; };
layout(set = 0, binding = 6)          buffer DK { float dk[]; };
layout(set = 0, binding = 7)          buffer DV { float dv[]; };

layout(push_constant) uniform Params {
    uint n_q_heads;
    uint n_kv_heads;
    uint head_size;
    uint token_count;
    uint q_size;
    uint kv_size;
    uint causal;
} p;

shared float k_shared[256];
shared float v_shared[256];
shared float partial[WG];
shared float scratch[2];

void main() {
    uint kv_h = gl_WorkGroupID.x;
    uint t_k  = gl_WorkGroupID.y;
    uint tid  = gl_LocalInvocationID.x;

    uint D = p.head_size;
    uint T = p.token_count;
    uint group_size = p.n_q_heads / p.n_kv_heads;
    float inv_sqrt_d = inversesqrt(float(D));

    uint k_base = t_k * p.kv_size + kv_h * D;
    uint v_base = t_k * p.kv_size + kv_h * D;

    for (uint d = tid; d < D; d += WG) {
        k_shared[d] = k_buf[k_base + d];
        v_shared[d] = v_buf[v_base + d];
    }
    barrier();

    float d_k_acc = 0.0;
    float d_v_acc = 0.0;
    uint  my_d    = tid;

    for (uint q_h_off = 0u; q_h_off < group_size; q_h_off += 1u) {
        uint h = kv_h * group_size + q_h_off;

        uint t_q_min = (p.causal != 0u) ? t_k : 0u;
        for (uint t_q = t_q_min; t_q < T; t_q += 1u) {
            uint q_base  = t_q * p.q_size + h * D;
            uint do_base = t_q * p.q_size + h * D;

            float s_part = 0.0;
            for (uint d = tid; d < D; d += WG) {
                s_part += q_buf[q_base + d] * k_shared[d];
            }
            partial[tid] = s_part;
            barrier();
            for (uint st = WG / 2u; st > 0u; st >>= 1) {
                if (tid < st) partial[tid] += partial[tid + st];
                barrier();
            }
            if (tid == 0u) scratch[0] = partial[0];
            barrier();
            float raw_score = scratch[0];
            barrier();

            float dp_part = 0.0;
            for (uint d = tid; d < D; d += WG) {
                dp_part += dout[do_base + d] * v_shared[d];
            }
            partial[tid] = dp_part;
            barrier();
            for (uint st = WG / 2u; st > 0u; st >>= 1) {
                if (tid < st) partial[tid] += partial[tid + st];
                barrier();
            }
            if (tid == 0u) scratch[1] = partial[0];
            barrier();
            float d_P = scratch[1];

            float p_val   = exp(raw_score * inv_sqrt_d - lse[h * T + t_q]);
            float d_S_inv = p_val * (d_P - d_acc[h * T + t_q]) * inv_sqrt_d;

            if (my_d < D) {
                d_v_acc += p_val   * dout [do_base + my_d];
                d_k_acc += d_S_inv * q_buf[q_base  + my_d];
            }
            barrier();
        }
    }

    if (my_d < D) {
        dk[k_base + my_d] += d_k_acc;
        dv[v_base + my_d] += d_v_acc;
    }
}
