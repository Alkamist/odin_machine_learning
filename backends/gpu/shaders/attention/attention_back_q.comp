// Backward for Q (per (q_head, query) position).
//   q:     [T, n_q_heads * D]
//   k,v:   [T, n_kv_heads * D]
//   d_o:   [T, n_q_heads * D]
//   lse:   [n_q_heads, T]
//   d_acc: [n_q_heads, T]
//   d_q:   [T, n_q_heads * D]   accumulating
#version 450

#define WG 64

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly buffer Q  { float q_buf[]; };
layout(set = 0, binding = 1) readonly buffer K  { float k_buf[]; };
layout(set = 0, binding = 2) readonly buffer V  { float v_buf[]; };
layout(set = 0, binding = 3) readonly buffer DO { float dout[]; };
layout(set = 0, binding = 4) readonly buffer L  { float lse[]; };
layout(set = 0, binding = 5) readonly buffer DA { float d_acc[]; };
layout(set = 0, binding = 6)          buffer DQ { float dq[]; };

layout(push_constant) uniform Params {
    uint n_q_heads;
    uint n_kv_heads;
    uint head_size;
    uint token_count;
    uint q_size;
    uint kv_size;
    uint causal;
    uint window;
} p;

shared float q_shared[256];
shared float do_shared[256];
shared float partial[WG];
shared float scratch[2];

void main() {
    uint h    = gl_WorkGroupID.x;
    uint t_q  = gl_WorkGroupID.y;
    uint tid  = gl_LocalInvocationID.x;

    uint D    = p.head_size;
    uint T    = p.token_count;
    uint kv_h = h * p.n_kv_heads / p.n_q_heads;
    float inv_sqrt_d = inversesqrt(float(D));

    uint q_base  = t_q * p.q_size + h * D;
    uint do_base = t_q * p.q_size + h * D;

    for (uint d = tid; d < D; d += WG) {
        q_shared[d]  = q_buf[q_base + d];
        do_shared[d] = dout [do_base + d];
    }
    barrier();

    float lse_q = lse[h * T + t_q];
    float dac_q = d_acc[h * T + t_q];

    float d_q_acc = 0.0;
    uint  my_d    = tid;

    uint t_k_max = (p.causal != 0u) ? (t_q + 1u) : T;
    uint t_k_min = (p.window != 0u && t_k_max > p.window) ? (t_k_max - p.window) : 0u;
    for (uint t_k = t_k_min; t_k < t_k_max; t_k += 1u) {
        uint k_base = t_k * p.kv_size + kv_h * D;
        uint v_base = t_k * p.kv_size + kv_h * D;

        float s_part = 0.0;
        for (uint d = tid; d < D; d += WG) {
            s_part += q_shared[d] * k_buf[k_base + d];
        }
        partial[tid] = s_part;
        barrier();
        for (uint st = WG / 2u; st > 0u; st >>= 1) {
            if (tid < st) partial[tid] += partial[tid + st];
            barrier();
        }
        if (tid == 0u) scratch[0] = partial[0];
        barrier();
        float raw_score = scratch[0];
        barrier();

        float dp_part = 0.0;
        for (uint d = tid; d < D; d += WG) {
            dp_part += do_shared[d] * v_buf[v_base + d];
        }
        partial[tid] = dp_part;
        barrier();
        for (uint st = WG / 2u; st > 0u; st >>= 1) {
            if (tid < st) partial[tid] += partial[tid + st];
            barrier();
        }
        if (tid == 0u) scratch[1] = partial[0];
        barrier();
        float d_P = scratch[1];

        float p_val   = exp(raw_score * inv_sqrt_d - lse_q);
        float d_S_inv = p_val * (d_P - dac_q) * inv_sqrt_d;

        if (my_d < D) {
            d_q_acc += d_S_inv * k_buf[k_base + my_d];
        }
        barrier();
    }

    if (my_d < D) {
        dq[q_base + my_d] += d_q_acc;
    }
}
