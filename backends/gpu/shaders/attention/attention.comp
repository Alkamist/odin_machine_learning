// Online-softmax (FA2-style) single-head attention forward.
// GQA-capable: K/V share head index `h * n_kv / n_q`.
//   q:   [T, n_q_heads * D]
//   k,v: [T, n_kv_heads * D]
//   o:   [T, n_q_heads * D]
//   lse: [n_q_heads, T]
//
// One workgroup per (q_head, query). Threads parallelize over the head
// dim for the per-tile score reduction and for the running output update.
#version 450

#define WG    64
#define BC    64
#define MAX_D 256
#define O_SLOTS ((MAX_D + WG - 1) / WG)

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly  buffer Q { float q_buf[]; };
layout(set = 0, binding = 1) readonly  buffer K { float k_buf[]; };
layout(set = 0, binding = 2) readonly  buffer V { float v_buf[]; };
layout(set = 0, binding = 3) writeonly buffer O { float o[]; };
layout(set = 0, binding = 4) writeonly buffer L { float lse[]; };

layout(push_constant) uniform Params {
    uint n_q_heads;
    uint n_kv_heads;
    uint head_size;
    uint token_count;
    uint q_size;
    uint kv_size;
    uint causal;
    uint window;
} p;

shared float q_shared[MAX_D];
shared float score_tile[BC];
shared float partial[WG];

const float NEG_INF = -3.402823e38;

void main() {
    uint h    = gl_WorkGroupID.x;
    uint t_q  = gl_WorkGroupID.y;
    uint tid  = gl_LocalInvocationID.x;

    uint D    = p.head_size;
    uint T    = p.token_count;
    uint kv_h = h * p.n_kv_heads / p.n_q_heads;
    float inv_sqrt_d = inversesqrt(float(D));
    uint t_k_max = (p.causal != 0u) ? (t_q + 1u) : T;
    uint t_k_min = (p.window != 0u && t_k_max > p.window) ? (t_k_max - p.window) : 0u;
    uint t_k0_start = (t_k_min / BC) * BC;

    uint q_base = t_q * p.q_size + h    * D;
    uint o_base = t_q * p.q_size + h    * D;

    for (uint d = tid; d < D; d += WG) {
        q_shared[d] = q_buf[q_base + d];
    }
    barrier();

    float o_acc[O_SLOTS];
    for (uint slot = 0u; slot < O_SLOTS; slot += 1u) o_acc[slot] = 0.0;

    float m_run = NEG_INF;
    float l_run = 0.0;

    for (uint t_k0 = t_k0_start; t_k0 < t_k_max; t_k0 += BC) {
        uint t_k = t_k0 + tid;
        float score = NEG_INF;
        if (tid < BC && t_k < t_k_max && t_k >= t_k_min) {
            uint k_base = t_k * p.kv_size + kv_h * D;
            float dot = 0.0;
            for (uint d = 0u; d < D; d += 1u) {
                dot += q_shared[d] * k_buf[k_base + d];
            }
            score = dot * inv_sqrt_d;
        }
        if (tid < BC) score_tile[tid] = score;
        partial[tid] = score;
        barrier();

        for (uint stride2 = WG / 2u; stride2 > 0u; stride2 >>= 1) {
            if (tid < stride2) partial[tid] = max(partial[tid], partial[tid + stride2]);
            barrier();
        }
        float m_tile = partial[0];
        float m_new  = max(m_run, m_tile);

        float p_val = (tid < BC) ? exp(score_tile[tid] - m_new) : 0.0;
        if (tid < BC) score_tile[tid] = p_val;
        partial[tid] = p_val;
        barrier();
        for (uint stride2 = WG / 2u; stride2 > 0u; stride2 >>= 1) {
            if (tid < stride2) partial[tid] += partial[tid + stride2];
            barrier();
        }
        float l_tile = partial[0];

        float alpha = (m_run == NEG_INF) ? 0.0 : exp(m_run - m_new);
        l_run = alpha * l_run + l_tile;
        m_run = m_new;

        for (uint slot = 0u; slot < O_SLOTS; slot += 1u) {
            uint d = tid + slot * WG;
            if (d < D) {
                float contrib = 0.0;
                uint j_max = min(BC, t_k_max - t_k0);
                for (uint j = 0u; j < j_max; j += 1u) {
                    uint v_base = (t_k0 + j) * p.kv_size + kv_h * D;
                    contrib += score_tile[j] * v_buf[v_base + d];
                }
                o_acc[slot] = alpha * o_acc[slot] + contrib;
            }
        }
        barrier();
    }

    float inv_l = 1.0 / l_run;
    for (uint slot = 0u; slot < O_SLOTS; slot += 1u) {
        uint d = tid + slot * WG;
        if (d < D) {
            o[o_base + d] = o_acc[slot] * inv_l;
        }
    }

    if (tid == 0u) {
        lse[h * T + t_q] = m_run + log(l_run);
    }
}
