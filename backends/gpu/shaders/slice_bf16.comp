// Bf16 forward of `slice`: out[i] = in[start + i].
// One thread per output PAIR. The two halves can be at non-aligned source
// offsets, so each is loaded via shift-extract and packed back into one uint.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params { uint n; uint start; uint pair_count; } p;

uint load_bf16(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (x[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;

    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint lo = 0u;
    uint hi = 0u;
    if (i0 < p.n) lo = load_bf16(p.start + i0);
    if (i1 < p.n) hi = load_bf16(p.start + i1);

    y[pair] = (hi << 16) | lo;
}
