// Bf16 backward of rope. Same pair structure as the forward — each (lo, hi)
// pair lives at an even input index, so one thread owns one packed dx uint
// and does a packed RMW.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer DX { uint dx[]; };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[]; };

layout(push_constant) uniform Params {
    uint  token_count;
    uint  head_count;
    uint  head_size;
    float base;
} p;

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

uint bf16_round(float v) {
    uint bits = floatBitsToUint(v);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

void main() {
    uint gid     = gl_GlobalInvocationID.x;
    uint half_hs = p.head_size / 2u;
    uint total   = p.token_count * p.head_count * half_hs;
    if (gid >= total) return;

    uint pair_idx = gid % half_hs;
    uint hg       = gid / half_hs;
    uint head     = hg % p.head_count;
    uint pos      = hg / p.head_count;

    float exponent = float(pair_idx * 2u) / float(p.head_size);
    float theta    = float(pos) / pow(p.base, exponent);
    float c_v      = cos(theta);
    float s_v      = sin(theta);

    uint head_offset = pos * p.head_count * p.head_size + head * p.head_size;
    uint i_lo        = head_offset + pair_idx * 2u;
    uint pair_index  = i_lo >> 1u;

    uint dy_packed = dy[pair_index];
    float gx = bf16_expand(dy_packed & 0xffffu);
    float gy = bf16_expand((dy_packed >> 16) & 0xffffu);

    uint dx_packed = dx[pair_index];
    float dx_lo_cur = bf16_expand(dx_packed & 0xffffu);
    float dx_hi_cur = bf16_expand((dx_packed >> 16) & 0xffffu);

    uint out_lo = bf16_round(dx_lo_cur +  gx * c_v + gy * s_v);
    uint out_hi = bf16_round(dx_hi_cur + -gx * s_v + gy * c_v);

    dx[pair_index] = (out_hi << 16) | out_lo;
}
