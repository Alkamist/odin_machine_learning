// Backward of `linear` w.r.t. input.
//   forward:  y[c, o] = sum_k W[o, k] * x[c, k]
//   backward: dx[c, k] += sum_o W[o, k] * dy[c, o]
//
// Naive thread-per-output: each thread owns one (c, k) and reduces over o.
// No atomics. Tiled GEMM is overkill until backward becomes a profile blip.
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer DY { float dy[]; }; // [count, output_size]
layout(set = 0, binding = 1) readonly buffer W  { float w[];  }; // [output_size, input_size]
layout(set = 0, binding = 2)          buffer DX { float dx[]; }; // [count, input_size]

layout(push_constant) uniform Params {
    uint count;
    uint input_size;
    uint output_size;
} p;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint k = gl_GlobalInvocationID.y;
    if (c >= p.count || k >= p.input_size) return;

    float acc = 0.0;
    for (uint o = 0u; o < p.output_size; o++) {
        acc += dy[c * p.output_size + o] * w[o * p.input_size + k];
    }
    dx[c * p.input_size + k] += acc;
}
