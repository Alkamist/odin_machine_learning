// Cast n f32 elements to n bf16 elements. dst is packed two bf16 per uint:
// low 16 bits = element 2*i, high 16 bits = element 2*i+1. Round-to-nearest-
// even, NaN preserved.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer SRC { float src[]; };
layout(set = 0, binding = 1) writeonly buffer DST { uint  dst[]; };
layout(push_constant) uniform Params { uint n; uint pair_count; } p;

uint bf16_round(float x) {
    uint bits = floatBitsToUint(x);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.pair_count) return;

    uint i0 = 2u * i;
    uint i1 = i0 + 1u;

    uint lo = bf16_round(src[i0]);
    uint hi = (i1 < p.n) ? bf16_round(src[i1]) : 0u;

    dst[i] = (hi << 16) | lo;
}
