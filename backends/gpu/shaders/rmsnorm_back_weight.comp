// Backward of rmsnorm w.r.t. weight.
//   dW[i] += sum_c norm[c, i] * dy[c, i]
// where norm[c, i] = x[c, i] * rstd[c].
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X  { float x[];    };
layout(set = 0, binding = 1) readonly buffer DY { float dy[];   };
layout(set = 0, binding = 2) readonly buffer R  { float rstd[]; };
layout(set = 0, binding = 3)          buffer DW { float dw[];   };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.size) return;

    float acc = 0.0;
    for (uint c = 0u; c < p.count; c++) {
        float norm = x[c * p.size + i] * rstd[c];
        acc += norm * dy[c * p.size + i];
    }
    dw[i] += acc;
}
