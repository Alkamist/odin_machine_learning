// Bf16 forward of rope. head_size is asserted even, head_offset is therefore
// even, and i_lo = head_offset + pair_idx*2 is even. So each (i_lo, i_hi)
// pair lands cleanly on one packed bf16 uint slot — one thread per pair
// reads the packed input, rotates in f32, writes the packed output.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer In  { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Out { uint y[]; };

layout(push_constant) uniform Params {
    uint  token_count;
    uint  head_count;
    uint  head_size;
    float base;
} p;

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

uint bf16_round(float v) {
    uint bits = floatBitsToUint(v);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

void main() {
    uint gid     = gl_GlobalInvocationID.x;
    uint half_hs = p.head_size / 2u;
    uint total   = p.token_count * p.head_count * half_hs;
    if (gid >= total) return;

    uint pair_idx = gid % half_hs;
    uint hg       = gid / half_hs;
    uint head     = hg % p.head_count;
    uint pos      = hg / p.head_count;

    float exponent = float(pair_idx * 2u) / float(p.head_size);
    float theta    = float(pos) / pow(p.base, exponent);
    float c_v      = cos(theta);
    float s_v      = sin(theta);

    uint head_offset = pos * p.head_count * p.head_size + head * p.head_size;
    uint i_lo        = head_offset + pair_idx * 2u;
    uint pair_index  = i_lo >> 1u; // even, exact

    uint packed = x[pair_index];
    float xv = bf16_expand(packed & 0xffffu);
    float yv = bf16_expand((packed >> 16) & 0xffffu);

    uint out_lo = bf16_round(xv * c_v - yv * s_v);
    uint out_hi = bf16_round(xv * s_v + yv * c_v);

    y[pair_index] = (out_hi << 16) | out_lo;
}
