// Bf16 backward of batched_matmul w.r.t. B.
//   dB[bi, k, j] += sum_i A[bi, i, k] * dC[bi, i, j]
//
// Thread per (bi, k, j_pair); writes a whole packed uint. N must be even.
#version 450
#include "bf16.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer A  { uint a[];  };
layout(set = 0, binding = 1) readonly buffer DC { uint dc[]; };
layout(set = 0, binding = 2)          buffer DB { uint db[]; };

layout(push_constant) uniform Params {
    uint batch_count;
    uint m;
    uint k;
    uint n;
} p;

void main() {
    uint kk     = gl_GlobalInvocationID.x;
    uint j_pair = gl_GlobalInvocationID.y;
    uint bi     = gl_GlobalInvocationID.z;

    uint j_pair_count = p.n >> 1u;
    if (kk >= p.k || j_pair >= j_pair_count || bi >= p.batch_count) return;

    uint j_lo = 2u * j_pair;

    float acc_lo = 0.0;
    float acc_hi = 0.0;
    for (uint ii = 0u; ii < p.m; ++ii) {
        uint a_elem  = bi * p.m * p.k + ii * p.k + kk;
        float a_val  = bf16_expand((a[a_elem >> 1u] >> ((a_elem & 1u) * 16u)) & 0xffffu);

        uint dc_pair = dc[(bi * p.m * p.n + ii * p.n + j_lo) >> 1u];
        float dc_lo  = bf16_expand(dc_pair & 0xffffu);
        float dc_hi  = bf16_expand((dc_pair >> 16) & 0xffffu);

        acc_lo += a_val * dc_lo;
        acc_hi += a_val * dc_hi;
    }

    uint db_pair_idx = (bi * p.k * p.n + kk * p.n + j_lo) >> 1u;
    uint cur = db[db_pair_idx];
    float cur_lo = bf16_expand(cur & 0xffffu);
    float cur_hi = bf16_expand((cur >> 16) & 0xffffu);
    db[db_pair_idx] = (bf16_round(cur_hi + acc_hi) << 16) | bf16_round(cur_lo + acc_lo);
}
