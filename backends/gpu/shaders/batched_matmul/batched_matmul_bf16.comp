// Bf16 batched_matmul forward.
//   C[bi, i, j] = sum_k A[bi, i, k] * B[bi, k, j]
//
// Thread per (bi, i, j_pair); writes a whole packed uint, so N must be even.
// K is iterated element-by-element on A and pair-by-pair on B (since both j
// halves share a B row).
#version 450
#include "bf16.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer A { uint a[]; };
layout(set = 0, binding = 1) readonly  buffer B { uint b[]; };
layout(set = 0, binding = 2) writeonly buffer C { uint c[]; };

layout(push_constant) uniform Params {
    uint batch_count;
    uint m;
    uint k;
    uint n;
} p;

void main() {
    uint i      = gl_GlobalInvocationID.x;
    uint j_pair = gl_GlobalInvocationID.y;
    uint bi     = gl_GlobalInvocationID.z;

    uint j_pair_count = p.n >> 1u;
    if (i >= p.m || j_pair >= j_pair_count || bi >= p.batch_count) return;

    uint j_lo = 2u * j_pair;

    float acc_lo = 0.0;
    float acc_hi = 0.0;
    for (uint kk = 0u; kk < p.k; ++kk) {
        uint a_elem  = bi * p.m * p.k + i * p.k + kk;
        float a_val  = bf16_expand((a[a_elem >> 1u] >> ((a_elem & 1u) * 16u)) & 0xffffu);

        uint b_pair  = b[(bi * p.k * p.n + kk * p.n + j_lo) >> 1u];
        float b_lo   = bf16_expand(b_pair & 0xffffu);
        float b_hi   = bf16_expand((b_pair >> 16) & 0xffffu);

        acc_lo += a_val * b_lo;
        acc_hi += a_val * b_hi;
    }

    uint c_pair_idx = (bi * p.m * p.n + i * p.n + j_lo) >> 1u;
    c[c_pair_idx] = (bf16_round(acc_hi) << 16) | bf16_round(acc_lo);
}
