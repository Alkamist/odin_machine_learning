// Bf16 backward of batched_matmul w.r.t. A.
//   dA[bi, i, k] += sum_j dC[bi, i, j] * B[bi, k, j]
//
// Thread per (bi, i, k_pair); writes a whole packed uint. K must be even and
// N must be even (so j is iterated in pairs).
#version 450
#include "bf16.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer DC { uint dc[]; };
layout(set = 0, binding = 1) readonly buffer B  { uint b[];  };
layout(set = 0, binding = 2)          buffer DA { uint da[]; };

layout(push_constant) uniform Params {
    uint batch_count;
    uint m;
    uint k;
    uint n;
} p;

void main() {
    uint i      = gl_GlobalInvocationID.x;
    uint k_pair = gl_GlobalInvocationID.y;
    uint bi     = gl_GlobalInvocationID.z;

    uint k_pair_count = p.k >> 1u;
    if (i >= p.m || k_pair >= k_pair_count || bi >= p.batch_count) return;

    uint k_lo = 2u * k_pair;
    uint k_hi = k_lo + 1u;

    uint dc_base = (bi * p.m * p.n + i * p.n) >> 1u;
    uint b_lo_base = (bi * p.k * p.n + k_lo * p.n) >> 1u;
    uint b_hi_base = (bi * p.k * p.n + k_hi * p.n) >> 1u;

    float acc_lo = 0.0;
    float acc_hi = 0.0;
    uint j_pair_count = p.n >> 1u;
    for (uint jp = 0u; jp < j_pair_count; ++jp) {
        uint dc_pair = dc[dc_base + jp];
        float dc_j0 = bf16_expand(dc_pair & 0xffffu);
        float dc_j1 = bf16_expand((dc_pair >> 16) & 0xffffu);

        uint b_lo_pair = b[b_lo_base + jp];
        uint b_hi_pair = b[b_hi_base + jp];

        acc_lo += dc_j0 * bf16_expand(b_lo_pair & 0xffffu)
               +  dc_j1 * bf16_expand((b_lo_pair >> 16) & 0xffffu);
        acc_hi += dc_j0 * bf16_expand(b_hi_pair & 0xffffu)
               +  dc_j1 * bf16_expand((b_hi_pair >> 16) & 0xffffu);
    }

    uint da_pair_idx = (bi * p.m * p.k + i * p.k + k_lo) >> 1u;
    uint cur = da[da_pair_idx];
    float cur_lo = bf16_expand(cur & 0xffffu);
    float cur_hi = bf16_expand((cur >> 16) & 0xffffu);
    da[da_pair_idx] = (bf16_round(cur_hi + acc_hi) << 16) | bf16_round(cur_lo + acc_lo);
}
