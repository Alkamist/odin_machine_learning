// b.grad[j] += sum_i dy[i*n_b + j] * a[i*n_b + j], packed bf16.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer A    { uint a[];    };
layout(set = 0, binding = 1) readonly buffer DY   { uint dy[];   };
layout(set = 0, binding = 2)          buffer DA_B { uint da_b[]; };
layout(push_constant) uniform Params { uint n_b; uint stride; uint pair_count; } p;

float bf16_expand(uint half_bits) { return uintBitsToFloat(half_bits << 16); }
uint bf16_round(float x) {
    uint bits = floatBitsToUint(x);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}
uint load_half(uint buf_pair, uint shift) { return (buf_pair >> shift) & 0xffffu; }

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;
    uint j0 = 2u * pair;
    uint j1 = j0 + 1u;
    float acc0 = 0.0;
    float acc1 = 0.0;
    for (uint i = 0; i < p.stride; ++i) {
        uint row = i * p.n_b;
        if (j0 < p.n_b) {
            uint idx = row + j0;
            uint pi  = idx >> 1u;
            uint sh  = (idx & 1u) * 16u;
            float dy_v = bf16_expand(load_half(dy[pi], sh));
            float a_v  = bf16_expand(load_half(a [pi], sh));
            acc0 += dy_v * a_v;
        }
        if (j1 < p.n_b) {
            uint idx = row + j1;
            uint pi  = idx >> 1u;
            uint sh  = (idx & 1u) * 16u;
            float dy_v = bf16_expand(load_half(dy[pi], sh));
            float a_v  = bf16_expand(load_half(a [pi], sh));
            acc1 += dy_v * a_v;
        }
    }
    uint da_pair = da_b[pair];
    uint lo = da_pair & 0xffffu;
    uint hi = (da_pair >> 16) & 0xffffu;
    if (j0 < p.n_b) lo = bf16_round(bf16_expand(lo) + acc0);
    if (j1 < p.n_b) hi = bf16_round(bf16_expand(hi) + acc1);
    da_b[pair] = (hi << 16) | lo;
}
