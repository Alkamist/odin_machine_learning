// Bf16 rmsnorm backward (input). One workgroup per row, size must be even.
// Each workgroup uniquely owns its row in dx so RMW writes are race-free.
#version 450
#define BLOCK 256
layout(local_size_x = BLOCK) in;
layout(set = 0, binding = 0) readonly buffer X  { uint  x[];    };
layout(set = 0, binding = 1) readonly buffer W  { uint  w[];    };
layout(set = 0, binding = 2) readonly buffer DY { uint  dy[];   };
layout(set = 0, binding = 3) readonly buffer R  { float rstd[]; };
layout(set = 0, binding = 4)          buffer DX { uint  dx[];   };
layout(push_constant) uniform Params { uint count; uint size; } p;

shared float s_dn_norm[BLOCK];

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint pair_count = p.size >> 1u;
    uint pair_base  = (row * p.size) >> 1u;
    float rv = rstd[row];

    float pb = 0.0;
    for (uint pi = tid; pi < pair_count; pi += BLOCK) {
        uint xp  = x [pair_base + pi];
        uint wp  = w [pi];
        uint dyp = dy[pair_base + pi];
        float n0 = bf16_expand(xp & 0xffffu)         * rv;
        float n1 = bf16_expand((xp >> 16) & 0xffffu) * rv;
        float d0 = bf16_expand(wp & 0xffffu)         * bf16_expand(dyp & 0xffffu);
        float d1 = bf16_expand((wp >> 16) & 0xffffu) * bf16_expand((dyp >> 16) & 0xffffu);
        pb += d0 * n0 + d1 * n1;
    }
    s_dn_norm[tid] = pb;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_dn_norm[tid] += s_dn_norm[tid + stride];
        barrier();
    }
    float dnorm_norm_mean = s_dn_norm[0] / float(p.size);

    for (uint pi = tid; pi < pair_count; pi += BLOCK) {
        uint xp  = x [pair_base + pi];
        uint wp  = w [pi];
        uint dyp = dy[pair_base + pi];
        uint dxp = dx[pair_base + pi];

        float n0 = bf16_expand(xp & 0xffffu)         * rv;
        float n1 = bf16_expand((xp >> 16) & 0xffffu) * rv;
        float d0 = bf16_expand(wp & 0xffffu)         * bf16_expand(dyp & 0xffffu);
        float d1 = bf16_expand((wp >> 16) & 0xffffu) * bf16_expand((dyp >> 16) & 0xffffu);
        float g0 = (d0 - n0 * dnorm_norm_mean) * rv;
        float g1 = (d1 - n1 * dnorm_norm_mean) * rv;

        uint lo = bf16_round(bf16_expand(dxp & 0xffffu)         + g0);
        uint hi = bf16_round(bf16_expand((dxp >> 16) & 0xffffu) + g1);
        dx[pair_base + pi] = (hi << 16) | lo;
    }
}
