// Bf16 coopmat attention forward (FA2-with-Q-tiling layout).
//
// Each workgroup processes BR=16 contiguous queries against the full K/V
// sequence in BC=64-wide tiles. The Q@K^T and P@V matmuls run on tensor
// cores via cooperative_matrix; the online softmax (per-row max, exp,
// running sum) runs in SIMT using subgroup reductions across 32 lanes
// covering the BC=64 columns at 2 cols/thread.
//
// Constraints: subgroup size == 32, head_size % 16 == 0, head_size <= MAX_D.
#version 460

#extension GL_KHR_cooperative_matrix         : require
#extension GL_KHR_memory_scope_semantics     : require
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage       : require
#extension GL_EXT_bfloat16                   : require

#define BR      16
#define BC      64
#define M_FRAG  16
#define N_FRAG  16
#define K_FRAG  16
// Capped low because every shared array is sized for the worst-case D.
// At MAX_D=64 the WG uses ~32 KB shared, leaving room for 2 WGs/SM on a
// 64 KB budget. Heads larger than 64 fall back to the SIMT shader.
#define MAX_D   64
#define WG_SIZE 32

layout(local_size_x = WG_SIZE) in;

layout(set = 0, binding = 0) readonly  buffer Q { bfloat16_t q_buf[]; };
layout(set = 0, binding = 1) readonly  buffer K { bfloat16_t k_buf[]; };
layout(set = 0, binding = 2) readonly  buffer V { bfloat16_t v_buf[]; };
layout(set = 0, binding = 3) writeonly buffer O { bfloat16_t o[];   };
layout(set = 0, binding = 4) writeonly buffer L { float      lse[]; };

// GQA not supported in this shader (assert n_q_heads == n_kv_heads at dispatch).
// q_size and kv_size are equal here.
layout(push_constant) uniform Params {
    uint n_q_heads;
    uint n_kv_heads;
    uint head_size;
    uint token_count;
    uint q_size;
    uint kv_size;
    uint causal;
} p;

// All shared arrays are sized for the worst case head_size = MAX_D so the
// shader handles every D the host accepts; only the first D entries per row
// are used at run time.
shared bfloat16_t sq[BR * MAX_D];
shared bfloat16_t sk[BC * MAX_D];
shared bfloat16_t sv[BC * MAX_D];
shared float      sscore[BR * BC];
shared bfloat16_t sp[BR * BC];
shared float      so[BR * MAX_D];
shared float      stmp[BR * MAX_D];
shared float      m_run[BR];
shared float      l_run[BR];
shared float      alpha_sh[BR];

const float NEG_INF = -3.402823e38;

void main() {
    uint h       = gl_WorkGroupID.x;
    uint q_block = gl_WorkGroupID.y;
    uint tid     = gl_LocalInvocationID.x;

    uint D      = p.head_size;
    uint T      = p.token_count;
    uint E      = p.q_size;       // n_q_heads * D == n_kv_heads * D when GQA disabled
    uint q_base = q_block * BR;

    float inv_sqrt_d = inversesqrt(float(D));

    // Load Q tile: sq[r, d] = x[q_base + r, h*D + d].
    for (uint i = tid; i < BR * D; i += WG_SIZE) {
        uint r = i / D;
        uint d = i % D;
        uint t = q_base + r;
        sq[i] = (t < T) ? q_buf[t * E + h * D + d] : bfloat16_t(0.0f);
    }

    // Init running state and output accumulator.
    if (tid < BR) {
        m_run[tid] = NEG_INF;
        l_run[tid] = 0.0;
    }
    for (uint i = tid; i < BR * D; i += WG_SIZE) so[i] = 0.0;
    barrier();

    // Bound for the K loop: with causal, no key past the last query in this
    // block can ever contribute. Without causal, scan the full sequence.
    uint q_top    = min(q_base + BR, T);
    uint t_k_max  = (p.causal != 0u) ? q_top : T;

    for (uint t_k0 = 0u; t_k0 < t_k_max; t_k0 += BC) {
        // Stage K and V tiles. Out-of-range tokens get zeros (their scores
        // will be clamped to -inf in the softmax mask).
        for (uint i = tid; i < BC * D; i += WG_SIZE) {
            uint c = i / D;
            uint d = i % D;
            uint t = t_k0 + c;
            if (t < T) {
                sk[i] = k_buf[t * E + h * D + d];
                sv[i] = v_buf[t * E + h * D + d];
            } else {
                sk[i] = bfloat16_t(0.0f);
                sv[i] = bfloat16_t(0.0f);
            }
        }
        barrier();

        // Q @ K^T: BR x BC scores accumulated in fp32 across BC/N_FRAG = 4
        // column-tiles, with the K dim walked in K_FRAG=16-wide chunks.
        coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator> sacc[BC / N_FRAG];
        for (uint j = 0u; j < BC / N_FRAG; ++j)
            sacc[j] = coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(0.0f);

        for (uint kk = 0u; kk < D / K_FRAG; ++kk) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, K_FRAG, gl_MatrixUseA> mQ;
            coopMatLoad(mQ, sq, kk * K_FRAG, D, gl_CooperativeMatrixLayoutRowMajor);

            for (uint j = 0u; j < BC / N_FRAG; ++j) {
                coopmat<bfloat16_t, gl_ScopeSubgroup, K_FRAG, N_FRAG, gl_MatrixUseB> mK;
                // sk is [BC, D] row-major. Reading column-major with stride D
                // gives B[d, c] = sk[c, d] = K[c, d], i.e. K^T.
                uint k_off = (j * N_FRAG) * D + kk * K_FRAG;
                coopMatLoad(mK, sk, k_off, D, gl_CooperativeMatrixLayoutColumnMajor);
                sacc[j] = coopMatMulAdd(mQ, mK, sacc[j]);
            }
        }
        for (uint j = 0u; j < BC / N_FRAG; ++j) {
            coopMatStore(sacc[j], sscore, j * N_FRAG, BC, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        // SIMT online softmax: 32 threads cover BC=64 cols at 2 cols/thread,
        // 16 rows handled sequentially with subgroup reductions.
        uint c0 = 2u * tid;
        uint c1 = c0 + 1u;

        for (uint r = 0u; r < BR; ++r) {
            float s0 = sscore[r * BC + c0] * inv_sqrt_d;
            float s1 = sscore[r * BC + c1] * inv_sqrt_d;

            uint t_q  = q_base + r;
            uint k0   = t_k0 + c0;
            uint k1   = t_k0 + c1;
            // Out-of-range keys and (with causal) keys beyond t_q get masked.
            bool m0 = (k0 >= t_k_max) || (p.causal != 0u && k0 > t_q);
            bool m1 = (k1 >= t_k_max) || (p.causal != 0u && k1 > t_q);
            if (m0) s0 = NEG_INF;
            if (m1) s1 = NEG_INF;

            float m_tile = subgroupMax(max(s0, s1));

            float m_old = m_run[r];
            float m_new = max(m_old, m_tile);
            float alpha = (m_old == NEG_INF) ? 0.0 : exp(m_old - m_new);

            float p0 = (m_new == NEG_INF) ? 0.0 : exp(s0 - m_new);
            float p1 = (m_new == NEG_INF) ? 0.0 : exp(s1 - m_new);
            float l_tile = subgroupAdd(p0 + p1);

            sp[r * BC + c0] = bfloat16_t(p0);
            sp[r * BC + c1] = bfloat16_t(p1);

            if (tid == 0u) {
                alpha_sh[r] = alpha;
                l_run[r]    = alpha * l_run[r] + l_tile;
                m_run[r]    = m_new;
            }
        }
        barrier();

        // P @ V: (BR x BC) @ (BC x D). Walk D in N_FRAG=16-wide column tiles;
        // contract over BC in K_FRAG=16-wide chunks.
        for (uint dn = 0u; dn < D / N_FRAG; ++dn) {
            coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator> oacc =
                coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(0.0f);

            for (uint kk = 0u; kk < BC / K_FRAG; ++kk) {
                coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, K_FRAG, gl_MatrixUseA> mP;
                coopmat<bfloat16_t, gl_ScopeSubgroup, K_FRAG, N_FRAG, gl_MatrixUseB> mV;
                // sp is [BR, BC] row-major.
                coopMatLoad(mP, sp, kk * K_FRAG, BC, gl_CooperativeMatrixLayoutRowMajor);
                // sv is [BC, D] row-major.
                coopMatLoad(mV, sv, kk * K_FRAG * D + dn * N_FRAG, D, gl_CooperativeMatrixLayoutRowMajor);
                oacc = coopMatMulAdd(mP, mV, oacc);
            }
            coopMatStore(oacc, stmp, dn * N_FRAG, D, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        // Fold into the running output: so[r, d] = alpha[r] * so[r, d] + stmp[r, d].
        for (uint i = tid; i < BR * D; i += WG_SIZE) {
            uint r = i / D;
            so[i] = alpha_sh[r] * so[i] + stmp[i];
        }
        barrier();
    }

    // Final normalize and store to bf16. lse is fp32, one entry per (h, q).
    uint o_base   = q_base * E + h * D;
    uint pair_cnt = D >> 1u;

    for (uint r = 0u; r < BR; ++r) {
        uint t_q = q_base + r;
        if (t_q >= T) break;
        float inv_l = (l_run[r] == 0.0) ? 0.0 : 1.0 / l_run[r];

        // Pair-pack store: each thread writes one bf16 pair. WG_SIZE=32
        // covers up to D/2 = 128 pairs per row in passes of 32.
        for (uint pi = tid; pi < pair_cnt; pi += WG_SIZE) {
            uint d0 = 2u * pi;
            uint d1 = d0 + 1u;
            float v0 = so[r * D + d0] * inv_l;
            float v1 = so[r * D + d1] * inv_l;
            o[t_q * E + h * D + d0] = bfloat16_t(v0);
            o[t_q * E + h * D + d1] = bfloat16_t(v1);
        }

        if (tid == 0u) {
            lse[h * T + t_q] = m_run[r] + log(l_run[r]);
        }
    }
}
