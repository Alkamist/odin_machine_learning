#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params { uint n; uint pair_count; } p;

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;
    uint xp = x[pair];
    uint i0 = 2u*pair, i1 = i0+1u;
    uint lo = 0u, hi = 0u;
    if (i0 < p.n) { float v = bf16_expand(xp & 0xffffu);        lo = bf16_round(v / (1.0 + exp(-v))); }
    if (i1 < p.n) { float v = bf16_expand((xp >> 16) & 0xffffu); hi = bf16_round(v / (1.0 + exp(-v))); }
    y[pair] = (hi << 16) | lo;
}
