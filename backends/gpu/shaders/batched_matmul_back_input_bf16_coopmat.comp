// Bf16 coopmat backward of batched_matmul w.r.t. A.
//   dA[bi, m, k] += sum_j dC[bi, m, j] * B[bi, k, j]
//
// Coopmat shape: M_out = m, N_out = k, K_inner = n. dC loads row-major;
// B is staged into shared with explicit transpose so the inner B coopmat
// load stays row-major.
//
// Constraints: m % BM == 0, k % BN == 0, n % BK == 0, subgroup size == 32.
#version 460

#extension GL_KHR_cooperative_matrix     : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic  : require
#extension GL_EXT_shader_16bit_storage   : require
#extension GL_EXT_bfloat16               : require

#define BM            64
#define BN            64
#define BK            16
#define M_FRAG        16
#define N_FRAG        16
#define K_FRAG        16
#define SUB_M         2
#define SUB_N         2
#define SM_TILES      (BM / (M_FRAG * SUB_M))
#define SN_TILES      (BN / (N_FRAG * SUB_N))
#define SUBGROUP_SIZE 32
#define WG_SIZE       (SUB_M * SUB_N * SUBGROUP_SIZE)

layout(local_size_x = WG_SIZE) in;

layout(set = 0, binding = 0) readonly buffer DC { bfloat16_t dc[]; };
layout(set = 0, binding = 1) readonly buffer B  { bfloat16_t b[];  };
layout(set = 0, binding = 2)          buffer DA { bfloat16_t da[]; };

layout(push_constant) uniform Params {
    uint batch_count;
    uint m;
    uint k;
    uint n;
} p;

shared bfloat16_t sa[BM * BK];
shared bfloat16_t sb[BK * BN];

void main() {
    uint wg_m = gl_WorkGroupID.x;
    uint wg_n = gl_WorkGroupID.y;
    uint bi   = gl_WorkGroupID.z;
    uint sg   = gl_SubgroupID;
    uint sg_m = sg / SUB_N;
    uint sg_n = sg % SUB_N;
    uint tid  = gl_LocalInvocationID.x;

    uint base_m   = wg_m * BM;
    uint base_n   = wg_n * BN;
    uint sg_m_off = sg_m * (SM_TILES * M_FRAG);
    uint sg_n_off = sg_n * (SN_TILES * N_FRAG);

    uint dc_batch = bi * p.m * p.n;
    uint b_batch  = bi * p.k * p.n;
    uint da_batch = bi * p.m * p.k;

    coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>
        acc[SM_TILES][SN_TILES];
    for (uint i = 0u; i < SM_TILES; ++i) {
        for (uint j = 0u; j < SN_TILES; ++j) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator> initial;
            uint y_row = base_m + sg_m_off + i * M_FRAG;
            uint y_col = base_n + sg_n_off + j * N_FRAG;
            coopMatLoad(initial, da, da_batch + y_row * p.k + y_col, p.k,
                        gl_CooperativeMatrixLayoutRowMajor);
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(initial);
        }
    }

    uint k_steps = p.n / BK;
    for (uint kt = 0u; kt < k_steps; ++kt) {
        // sa[m_local, k_inner] = dC[bi, base_m+m_local, kt*BK+k_inner]
        for (uint l = 0u; l < (BM * BK) / WG_SIZE; ++l) {
            uint idx = tid + l * WG_SIZE;
            uint row = idx / BK;
            uint col = idx % BK;
            sa[idx] = dc[dc_batch + (base_m + row) * p.n + (kt * BK + col)];
        }
        // sb[k_inner, n_out] = B[bi, base_n+n_out, kt*BK+k_inner]
        for (uint l = 0u; l < (BK * BN) / WG_SIZE; ++l) {
            uint idx = tid + l * WG_SIZE;
            uint row = idx / BN;
            uint col = idx % BN;
            sb[idx] = b[b_batch + (base_n + col) * p.n + (kt * BK + row)];
        }
        barrier();

        coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, K_FRAG, gl_MatrixUseA> mA[SM_TILES];
        coopmat<bfloat16_t, gl_ScopeSubgroup, K_FRAG, N_FRAG, gl_MatrixUseB> mB[SN_TILES];

        for (uint i = 0u; i < SM_TILES; ++i) {
            uint a_off = (sg_m_off + i * M_FRAG) * BK;
            coopMatLoad(mA[i], sa, a_off, BK, gl_CooperativeMatrixLayoutRowMajor);
        }
        for (uint j = 0u; j < SN_TILES; ++j) {
            uint b_off = (sg_n_off + j * N_FRAG);
            coopMatLoad(mB[j], sb, b_off, BN, gl_CooperativeMatrixLayoutRowMajor);
        }

        for (uint i = 0u; i < SM_TILES; ++i)
            for (uint j = 0u; j < SN_TILES; ++j)
                acc[i][j] = coopMatMulAdd(mA[i], mB[j], acc[i][j]);

        barrier();
    }

    for (uint i = 0u; i < SM_TILES; ++i) {
        for (uint j = 0u; j < SN_TILES; ++j) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator> result =
                coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(acc[i][j]);
            uint y_row = base_m + sg_m_off + i * M_FRAG;
            uint y_col = base_n + sg_n_off + j * N_FRAG;
            coopMatStore(result, da, da_batch + y_row * p.k + y_col, p.k,
                         gl_CooperativeMatrixLayoutRowMajor);
        }
    }
}
