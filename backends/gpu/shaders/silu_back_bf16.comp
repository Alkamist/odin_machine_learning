#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X  { uint x[];  };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[]; };
layout(set = 0, binding = 2)          buffer DX { uint dx[]; };
layout(push_constant) uniform Params { uint n; uint pair_count; } p;

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;
    uint xp = x[pair];
    uint dyp = dy[pair];
    uint dxp = dx[pair];
    uint lo = dxp & 0xffffu;
    uint hi = (dxp >> 16) & 0xffffu;
    uint i0 = 2u*pair, i1 = i0+1u;
    if (i0 < p.n) {
        float xv = bf16_expand(xp & 0xffffu);
        float dv = bf16_expand(dyp & 0xffffu);
        float s  = 1.0 / (1.0 + exp(-xv));
        lo = bf16_round(bf16_expand(lo) + dv * (s + xv * s * (1.0 - s)));
    }
    if (i1 < p.n) {
        float xv = bf16_expand((xp >> 16) & 0xffffu);
        float dv = bf16_expand((dyp >> 16) & 0xffffu);
        float s  = 1.0 / (1.0 + exp(-xv));
        hi = bf16_round(bf16_expand(hi) + dv * (s + xv * s * (1.0 - s)));
    }
    dx[pair] = (hi << 16) | lo;
}
