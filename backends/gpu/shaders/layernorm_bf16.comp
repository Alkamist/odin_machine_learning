// Bf16 layernorm forward. One workgroup per row, size must be even.
#version 450
#define WG 256
#define EPSILON 1e-5
layout(local_size_x = WG) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params { uint count; uint size; } p;

shared float partial[WG];

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint pair_count = p.size >> 1u;
    uint pair_base  = (row * p.size) >> 1u;

    float s = 0.0;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[pair_base + pi];
        s += bf16_expand(xp & 0xffffu) + bf16_expand((xp >> 16) & 0xffffu);
    }
    partial[tid] = s;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float mean = partial[0] / float(p.size);
    barrier();

    float v = 0.0;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[pair_base + pi];
        float d0 = bf16_expand(xp & 0xffffu)        - mean;
        float d1 = bf16_expand((xp >> 16) & 0xffffu) - mean;
        v += d0 * d0 + d1 * d1;
    }
    partial[tid] = v;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float rstd = inversesqrt(partial[0] / float(p.size) + EPSILON);
    barrier();

    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[pair_base + pi];
        uint wp = w[pi];
        float v0 = (bf16_expand(xp & 0xffffu)        - mean) * rstd * bf16_expand(wp & 0xffffu);
        float v1 = (bf16_expand((xp >> 16) & 0xffffu) - mean) * rstd * bf16_expand((wp >> 16) & 0xffffu);
        y[pair_base + pi] = (bf16_round(v1) << 16) | bf16_round(v0);
    }
}
