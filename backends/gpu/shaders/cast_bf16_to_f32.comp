// Cast n bf16 elements to n f32 elements. src is packed two bf16 per uint.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer SRC { uint  src[]; };
layout(set = 0, binding = 1) writeonly buffer DST { float dst[]; };
layout(push_constant) uniform Params { uint n; uint pair_count; } p;

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.pair_count) return;

    uint packed = src[i];
    uint i0 = 2u * i;
    uint i1 = i0 + 1u;

    if (i0 < p.n) dst[i0] = bf16_expand(packed & 0xffffu);
    if (i1 < p.n) dst[i1] = bf16_expand((packed >> 16) & 0xffffu);
}
