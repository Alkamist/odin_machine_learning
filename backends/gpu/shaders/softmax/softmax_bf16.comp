// Bf16 per-row softmax. One workgroup per row, three passes (max, sum, write).
// x and y are packed bf16 (two halves per uint, low=2i, high=2i+1). size must
// be even so a row starts at a packed pair boundary. f32 reductions internally.
#version 450
#include "bf16.glsl"

#define WG 256

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { uint y[]; };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float partial[WG];

float load_x(uint elem_idx) {
    uint pair = elem_idx >> 1u;
    uint shift = (elem_idx & 1u) * 16u;
    return bf16_expand((x[pair] >> shift) & 0xffffu);
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;
    uint off = row * p.size;

    float m = -3.402823e38;
    for (uint i = tid; i < p.size; i += WG) m = max(m, load_x(off + i));
    partial[tid] = m;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] = max(partial[tid], partial[tid + stride]);
        barrier();
    }
    float row_max = partial[0];
    barrier();

    float s = 0.0;
    for (uint i = tid; i < p.size; i += WG) s += exp(load_x(off + i) - row_max);
    partial[tid] = s;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float inv = 1.0 / partial[0];
    barrier();

    uint pair_count = p.size >> 1u;
    uint pair_base  = off >> 1u;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint i0 = 2u * pi;
        uint i1 = i0 + 1u;
        uint x_pair = x[pair_base + pi];
        float v0 = bf16_expand(x_pair & 0xffffu);
        float v1 = bf16_expand((x_pair >> 16) & 0xffffu);
        uint lo = bf16_round(exp(v0 - row_max) * inv);
        uint hi = bf16_round(exp(v1 - row_max) * inv);
        y[pair_base + pi] = (hi << 16) | lo;
    }
}
