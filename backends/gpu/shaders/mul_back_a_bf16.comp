// a.grad[i] += dy[i] * b[i % n_b], packed bf16.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer B    { uint b[];    };
layout(set = 0, binding = 1) readonly buffer DY   { uint dy[];   };
layout(set = 0, binding = 2)          buffer DA_A { uint da_a[]; };
layout(push_constant) uniform Params { uint n; uint n_b; uint pair_count; } p;

float bf16_expand(uint half_bits) { return uintBitsToFloat(half_bits << 16); }
uint bf16_round(float x) {
    uint bits = floatBitsToUint(x);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}
uint load_b(uint elem_index) {
    uint pair = elem_index >> 1u;
    uint shift = (elem_index & 1u) * 16u;
    return (b[pair] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;
    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;
    uint dy_pair = dy[pair];
    uint da_pair = da_a[pair];
    uint lo = da_pair & 0xffffu;
    uint hi = (da_pair >> 16) & 0xffffu;
    if (i0 < p.n) {
        float dy0 = bf16_expand(dy_pair & 0xffffu);
        float b0  = bf16_expand(load_b(i0 % p.n_b));
        lo = bf16_round(bf16_expand(lo) + dy0 * b0);
    }
    if (i1 < p.n) {
        float dy1 = bf16_expand((dy_pair >> 16) & 0xffffu);
        float b1  = bf16_expand(load_b(i1 % p.n_b));
        hi = bf16_round(bf16_expand(hi) + dy1 * b1);
    }
    da_a[pair] = (hi << 16) | lo;
}
