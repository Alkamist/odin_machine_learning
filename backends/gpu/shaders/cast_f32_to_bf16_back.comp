// Backward of cast(Bf16 -> F32): round f32 dst.grad and accumulate into
// bf16 src.grad. src.grad is packed two bf16 per uint. One thread per pair
// owns a uint, so the read-modify-write does not race.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 1)          buffer DX { uint  dx[]; };
layout(push_constant) uniform Params { uint n; uint pair_count; } p;

uint bf16_round(float x) {
    uint bits = floatBitsToUint(x);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.pair_count) return;

    uint i0 = 2u * i;
    uint i1 = i0 + 1u;

    uint existing = dx[i];
    uint lo_bits  = existing & 0xffffu;
    uint hi_bits  = (existing >> 16) & 0xffffu;

    if (i0 < p.n) {
        float sum = bf16_expand(lo_bits) + dy[i0];
        lo_bits = bf16_round(sum);
    }
    if (i1 < p.n) {
        float sum = bf16_expand(hi_bits) + dy[i1];
        hi_bits = bf16_round(sum);
    }

    dx[i] = (hi_bits << 16) | lo_bits;
}
