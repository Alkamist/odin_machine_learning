// Per-(head, query) precompute used by both kv-backward and q-backward:
//   d_acc[h, t_q] = dot(d_O[t_q, h*D : (h+1)*D], O[t_q, h*D : (h+1)*D])
//
// One workgroup per (head, query). Threads parallelize over the head dim
// for the dot reduction.
#version 450

#define WG 64

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly  buffer O  { float o[]; };
layout(set = 0, binding = 1) readonly  buffer DO { float dout[]; };
layout(set = 0, binding = 2) writeonly buffer DA { float d_acc[]; };

layout(push_constant) uniform Params {
    uint head_count;
    uint head_size;
    uint token_count;
    uint embed_size;
} p;

shared float partial[WG];

void main() {
    uint h    = gl_WorkGroupID.x;
    uint t_q  = gl_WorkGroupID.y;
    uint tid  = gl_LocalInvocationID.x;
    uint base = t_q * p.embed_size + h * p.head_size;

    float s = 0.0;
    for (uint d = tid; d < p.head_size; d += WG) {
        s += dout[base + d] * o[base + d];
    }
    partial[tid] = s;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    if (tid == 0u) {
        d_acc[h * p.token_count + t_q] = partial[0];
    }
}
