// Bf16 forward of `slice_trailing`. Layout: [leading, trailing] -> [leading,
// new_trailing], copying [start, start + new_trailing) from each row.
// One thread per output PAIR. Halves of a pair come from the same row but
// possibly non-aligned input positions, so each half is loaded via
// shift-extract and packed back into one uint.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params {
    uint leading;
    uint trailing;
    uint new_trailing;
    uint start;
    uint pair_count;
} p;

uint load_bf16(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (x[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;

    uint total_out = p.leading * p.new_trailing;
    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint lo = 0u;
    uint hi = 0u;
    if (i0 < total_out) {
        uint r = i0 / p.new_trailing;
        uint c = i0 % p.new_trailing;
        lo = load_bf16(r * p.trailing + p.start + c);
    }
    if (i1 < total_out) {
        uint r = i1 / p.new_trailing;
        uint c = i1 % p.new_trailing;
        hi = load_bf16(r * p.trailing + p.start + c);
    }
    y[pair] = (hi << 16) | lo;
}
