// Bf16 backward of `slice_trailing`: scatter dy back into the [start,
// start + new_trailing) column range of dx. Other columns of dx are left
// untouched (gradient comes from sibling ops).
// One thread per dx PAIR. Each half independently checks whether its column
// is inside the slice; if so it accumulates the matching dy element. RMW
// the whole packed dx uint once so the two halves don't race.
#version 450
#include "bf16.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0)          buffer DX { uint dx[]; };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[]; };
layout(push_constant) uniform Params {
    uint leading;
    uint trailing;
    uint new_trailing;
    uint start;
    uint dx_pair_count;
} p;

uint load_dy(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (dy[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.dx_pair_count) return;

    uint total_dx = p.leading * p.trailing;
    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint cur = dx[pair];
    uint cur_lo =  cur        & 0xffffu;
    uint cur_hi = (cur >> 16) & 0xffffu;

    uint lo = cur_lo;
    uint hi = cur_hi;

    if (i0 < total_dx) {
        uint r = i0 / p.trailing;
        uint c = i0 % p.trailing;
        if (c >= p.start && (c - p.start) < p.new_trailing) {
            float v = bf16_expand(load_dy(r * p.new_trailing + (c - p.start)));
            lo = bf16_round(bf16_expand(cur_lo) + v);
        }
    }
    if (i1 < total_dx) {
        uint r = i1 / p.trailing;
        uint c = i1 % p.trailing;
        if (c >= p.start && (c - p.start) < p.new_trailing) {
            float v = bf16_expand(load_dy(r * p.new_trailing + (c - p.start)));
            hi = bf16_round(bf16_expand(cur_hi) + v);
        }
    }
    dx[pair] = (hi << 16) | lo;
}
