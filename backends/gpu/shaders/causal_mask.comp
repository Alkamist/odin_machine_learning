// Causal mask forward: replace upper-triangle entries (t2 > t1) of every
// trailing [T, T] block with -inf, copy lower-triangle entries unchanged.
//
//   x: [..., T, T]   row-major
//   y: [..., T, T]
//
// One thread per element.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Params {
    uint total;       // total element count = n_blocks * T * T
    uint T;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.total) return;

    uint within = idx % (p.T * p.T);
    uint t1 = within / p.T;
    uint t2 = within % p.T;

    if (t2 <= t1) {
        y[idx] = x[idx];
    } else {
        // True -inf bit pattern; CPU writes math.NEG_INF_F32, this matches.
        y[idx] = uintBitsToFloat(0xFF800000u);
    }
}
