// Bf16 backward of `slice`: dx[start + i] += dy[i].
// dx pairs that straddle the slice region need both halves updated through
// a packed RMW. start may be odd, in which case one thread of dy maps to
// the high half of one dx pair and the next thread maps to the low half of
// the next dx pair — different threads, different pairs, no race.
//
// Strategy: one thread per input PAIR (covers two adjacent dx halves). For
// each half, find the corresponding dy index (i_dx - start) and add if in
// range. RMW the whole packed uint once.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer DY { uint dy[]; };
layout(set = 0, binding = 1)          buffer DX { uint dx[]; };
layout(push_constant) uniform Params { uint n; uint start; uint dx_pair_count; } p;

float bf16_expand(uint half_bits) {
    return uintBitsToFloat(half_bits << 16);
}

uint bf16_round(float v) {
    uint bits = floatBitsToUint(v);
    if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return (rounded >> 16) & 0xffffu;
}

uint load_dy(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (dy[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.dx_pair_count) return;

    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint cur = dx[pair];
    uint cur_lo = cur & 0xffffu;
    uint cur_hi = (cur >> 16) & 0xffffu;

    uint lo = cur_lo;
    uint hi = cur_hi;

    if (i0 >= p.start && (i0 - p.start) < p.n) {
        float v = bf16_expand(load_dy(i0 - p.start));
        lo = bf16_round(bf16_expand(cur_lo) + v);
    }
    if (i1 >= p.start && (i1 - p.start) < p.n) {
        float v = bf16_expand(load_dy(i1 - p.start));
        hi = bf16_round(bf16_expand(cur_hi) + v);
    }

    dx[pair] = (hi << 16) | lo;
}
