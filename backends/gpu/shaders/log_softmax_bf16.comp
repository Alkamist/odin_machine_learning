// Bf16 log_softmax. One workgroup per row, size must be even.
#version 450
#define BLOCK 256
layout(local_size_x = BLOCK) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params { uint count; uint size; } p;

shared float s_max[BLOCK];
shared float s_sum[BLOCK];

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}
float load_x(uint elem_idx) {
    uint pair = elem_idx >> 1u;
    uint shift = (elem_idx & 1u) * 16u;
    return bf16_expand((x[pair] >> shift) & 0xffffu);
}

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;
    uint base = row * p.size;

    float local_max = -3.402823e38;
    for (uint i = tid; i < p.size; i += BLOCK) {
        float v = load_x(base + i);
        if (v > local_max) local_max = v;
    }
    s_max[tid] = local_max;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_max[tid] = max(s_max[tid], s_max[tid + stride]);
        barrier();
    }
    float max_v = s_max[0];
    barrier();

    float local_sum = 0.0;
    for (uint i = tid; i < p.size; i += BLOCK) {
        local_sum += exp(load_x(base + i) - max_v);
    }
    s_sum[tid] = local_sum;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_sum[tid] += s_sum[tid + stride];
        barrier();
    }
    float log_sum_exp = log(s_sum[0]) + max_v;

    uint pair_count = p.size >> 1u;
    uint pair_base  = base >> 1u;
    for (uint pi = tid; pi < pair_count; pi += BLOCK) {
        uint xp = x[pair_base + pi];
        float v0 = bf16_expand(xp & 0xffffu);
        float v1 = bf16_expand((xp >> 16) & 0xffffu);
        uint lo = bf16_round(v0 - log_sum_exp);
        uint hi = bf16_round(v1 - log_sum_exp);
        y[pair_base + pi] = (hi << 16) | lo;
    }
}
