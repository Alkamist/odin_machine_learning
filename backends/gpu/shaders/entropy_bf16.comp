// Bf16 entropy: y[row] = -sum_i p[row, i] * log(max(p[row, i], 1e-8)).
// One workgroup per output pair (= 2 rows). Each workgroup computes the two
// row entropies sequentially using its threads to parallelize the inner sum,
// then thread 0 packs and writes a single uint. Requires size even so each
// row starts on a pair boundary.
#version 450
#define BLOCK 256
layout(local_size_x = BLOCK) in;
layout(set = 0, binding = 0) readonly  buffer P { uint prob[]; };
layout(set = 0, binding = 1) writeonly buffer Y { uint y[];    };
layout(push_constant) uniform Params { uint count; uint size; uint out_pair_count; } p;

shared float s_sum[BLOCK];

float bf16_expand(uint h) { return uintBitsToFloat(h << 16); }
uint bf16_round(float v) {
    uint b = floatBitsToUint(v);
    if ((b & 0x7fffffffu) > 0x7f800000u) return 0x7fc0u;
    uint r = b + 0x7fffu + ((b >> 16) & 1u);
    return (r >> 16) & 0xffffu;
}

float row_entropy(uint row, uint tid) {
    if (row >= p.count) return 0.0;
    uint pair_count = p.size >> 1u;
    uint pair_base  = (row * p.size) >> 1u;
    float local = 0.0;
    for (uint pi = tid; pi < pair_count; pi += BLOCK) {
        uint pp = prob[pair_base + pi];
        float v0 = bf16_expand(pp & 0xffffu);
        float v1 = bf16_expand((pp >> 16) & 0xffffu);
        local -= v0 * log(max(v0, 1e-8));
        local -= v1 * log(max(v1, 1e-8));
    }
    s_sum[tid] = local;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_sum[tid] += s_sum[tid + stride];
        barrier();
    }
    float result = s_sum[0];
    barrier();
    return result;
}

void main() {
    uint pair = gl_WorkGroupID.x;
    uint tid  = gl_LocalInvocationID.x;
    if (pair >= p.out_pair_count) return;

    uint r0 = 2u * pair;
    uint r1 = r0 + 1u;

    float e0 = row_entropy(r0, tid);
    float e1 = row_entropy(r1, tid);

    if (tid == 0u) {
        uint lo = bf16_round(e0);
        uint hi = (r1 < p.count) ? bf16_round(e1) : 0u;
        y[pair] = (hi << 16) | lo;
    }
}
