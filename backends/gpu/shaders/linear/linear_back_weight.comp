// Backward of `linear` w.r.t. weight.
//   dW[o, k] += sum_c x[c, k] * dy[c, o]
//
// Thread per (o, k); reduction across c. No atomics.
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer X  { float x[];  }; // [count, input_size]
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; }; // [count, output_size]
layout(set = 0, binding = 2)          buffer DW { float dw[]; }; // [output_size, input_size]

layout(push_constant) uniform Params {
    uint count;
    uint input_size;
    uint output_size;
} p;

void main() {
    uint o = gl_GlobalInvocationID.x;
    uint k = gl_GlobalInvocationID.y;
    if (o >= p.output_size || k >= p.input_size) return;

    float acc = 0.0;
    for (uint c = 0u; c < p.count; c++) {
        acc += x[c * p.input_size + k] * dy[c * p.output_size + o];
    }
    dw[o * p.input_size + k] += acc;
}
