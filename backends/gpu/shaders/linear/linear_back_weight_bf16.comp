// Bf16 backward of `linear` w.r.t. weight.
//   dw[o, k] += sum_c x[c, k] * dy[c, o]
//
// Thread per (o, k_pair); writes a whole packed uint, so K (input_size)
// must be even (asserted at dispatch).
#version 450
#include "bf16.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer X  { uint x[];  };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[]; };
layout(set = 0, binding = 2)          buffer DW { uint dw[]; };

layout(push_constant) uniform Params {
    uint count;
    uint input_size;
    uint output_size;
} p;

void main() {
    uint o      = gl_GlobalInvocationID.x;
    uint k_pair = gl_GlobalInvocationID.y;
    uint k_pair_count = p.input_size >> 1u;
    if (o >= p.output_size || k_pair >= k_pair_count) return;

    uint k_lo = 2u * k_pair;

    float acc_lo = 0.0;
    float acc_hi = 0.0;
    for (uint c = 0u; c < p.count; ++c) {
        uint dy_elem  = c * p.output_size + o;
        uint dy_pair  = dy[dy_elem >> 1u];
        float dy_val  = bf16_expand((dy_pair >> ((dy_elem & 1u) * 16u)) & 0xffffu);

        uint x_pair = x[(c * p.input_size + k_lo) >> 1u];
        float x_lo  = bf16_expand(x_pair & 0xffffu);
        float x_hi  = bf16_expand((x_pair >> 16) & 0xffffu);

        acc_lo += x_lo * dy_val;
        acc_hi += x_hi * dy_val;
    }

    uint dw_pair_idx = (o * p.input_size + k_lo) >> 1u;
    uint cur = dw[dw_pair_idx];
    float cur_lo = bf16_expand(cur & 0xffffu);
    float cur_hi = bf16_expand((cur >> 16) & 0xffffu);
    uint new_lo = bf16_round(cur_lo + acc_lo);
    uint new_hi = bf16_round(cur_hi + acc_hi);
    dw[dw_pair_idx] = (new_hi << 16) | new_lo;
}
