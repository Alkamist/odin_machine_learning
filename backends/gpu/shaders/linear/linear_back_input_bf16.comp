// Bf16 backward of `linear` w.r.t. input.
//   dx[c, k] += sum_o w[o, k] * dy[c, o]
//
// Each thread owns one (c, k_pair) and writes a whole packed uint, so two
// adjacent k columns are reduced together to avoid partial-uint races. K
// (input_size) must be even, asserted at dispatch.
#version 450
#include "bf16.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer DY { uint dy[]; };
layout(set = 0, binding = 1) readonly buffer W  { uint w[];  };
layout(set = 0, binding = 2)          buffer DX { uint dx[]; };

layout(push_constant) uniform Params {
    uint count;
    uint input_size;
    uint output_size;
} p;

void main() {
    uint c        = gl_GlobalInvocationID.x;
    uint k_pair   = gl_GlobalInvocationID.y;
    uint k_pair_count = p.input_size >> 1u;
    if (c >= p.count || k_pair >= k_pair_count) return;

    uint k_lo = 2u * k_pair;
    uint k_hi = k_lo + 1u;

    float acc_lo = 0.0;
    float acc_hi = 0.0;
    for (uint o = 0u; o < p.output_size; ++o) {
        // dy[c, o]
        uint dy_elem  = c * p.output_size + o;
        uint dy_pair  = dy[dy_elem >> 1u];
        float dy_val  = bf16_expand((dy_pair >> ((dy_elem & 1u) * 16u)) & 0xffffu);

        // w[o, k_pair] — k_lo and k_hi are even+odd so they share a uint
        uint w_pair = w[(o * p.input_size + k_lo) >> 1u];
        float w_lo  = bf16_expand(w_pair & 0xffffu);
        float w_hi  = bf16_expand((w_pair >> 16) & 0xffffu);

        acc_lo += w_lo * dy_val;
        acc_hi += w_hi * dy_val;
    }

    uint dx_pair_idx = (c * p.input_size + k_lo) >> 1u;
    uint cur = dx[dx_pair_idx];
    float cur_lo = bf16_expand(cur & 0xffffu);
    float cur_hi = bf16_expand((cur >> 16) & 0xffffu);
    uint new_lo = bf16_round(cur_lo + acc_lo);
    uint new_hi = bf16_round(cur_hi + acc_hi);
    dx[dx_pair_idx] = (new_hi << 16) | new_lo;
}
