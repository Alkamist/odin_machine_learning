// Q4_K weight x bf16 activation GEMM using cooperative matrix (tensor cores).
// Mirrors `linear_bf16_coopmat.comp` shape (BM=64, BN=64, 4 subgroups, fp32
// accumulator), differing only in how the W-tile is staged: each K-step covers
// exactly one Q4_K subblock (32 weights), and the staging step dequantizes
// Q4_K -> bf16 into shared memory before the coopmat matmul reads it.
//
//   y[m, n] = sum_k x[m, k] * w[n, k]      (W is [N, K] Q4_K, B = W^T)
//
// Constraints: M % BM == 0, N % BN == 0, K % BLOCK_K (256) == 0,
//              subgroup size == 32.
#version 460

#extension GL_KHR_cooperative_matrix     : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic  : require
#extension GL_EXT_shader_16bit_storage   : require
#extension GL_EXT_bfloat16               : require

#define BM            64
#define BN            64
#define BK            32   // one Q4_K subblock per K-step
#define M_FRAG        16
#define N_FRAG        16
#define K_FRAG        16
#define SUB_M         2
#define SUB_N         2
#define SM_TILES      (BM / (M_FRAG * SUB_M))      // 2
#define SN_TILES      (BN / (N_FRAG * SUB_N))      // 2
#define K_STEPS_PER_TILE (BK / K_FRAG)             // 2
#define SUBGROUP_SIZE 32
#define WG_SIZE       (SUB_M * SUB_N * SUBGROUP_SIZE)   // 128

#define BLOCK_K       256
#define BLOCK_UINTS   36   // 144 bytes / 4

layout(local_size_x = WG_SIZE) in;

layout(set = 0, binding = 0) readonly  buffer X { bfloat16_t x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint        w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { bfloat16_t y[]; };

layout(push_constant) uniform Params {
    uint M;
    uint K;
    uint N;
} p;

shared bfloat16_t sx[BM * BK];
shared bfloat16_t sw[BN * BK];

// Same scale/min unpack as linear_q4_k_gemv.comp; mirrors `get_scale_min_k4`.
void unpack_scale_min(uint sub, uint sw0, uint sw1, uint sw2, out uint scale, out uint min_v) {
    if (sub < 4u) {
        uint shift = sub * 8u;
        scale = (sw0 >> shift) & 0x3Fu;
        min_v = (sw1 >> shift) & 0x3Fu;
    } else {
        uint shift = (sub - 4u) * 8u;
        uint b_low = (sw2 >> shift) & 0xFFu;
        uint b_sc  = (sw0 >> shift) & 0xFFu;
        uint b_mn  = (sw1 >> shift) & 0xFFu;
        scale = (b_low & 0x0Fu) | ((b_sc >> 6u) << 4u);
        min_v = (b_low >>  4u)  | ((b_mn >> 6u) << 4u);
    }
}

void main() {
    uint wg_m = gl_WorkGroupID.x;
    uint wg_n = gl_WorkGroupID.y;
    uint sg   = gl_SubgroupID;
    uint sg_m = sg / SUB_N;
    uint sg_n = sg % SUB_N;
    uint tid  = gl_LocalInvocationID.x;

    uint base_m   = wg_m * BM;
    uint base_n   = wg_n * BN;
    uint sg_m_off = sg_m * (SM_TILES * M_FRAG);
    uint sg_n_off = sg_n * (SN_TILES * N_FRAG);

    coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>
        acc[SM_TILES][SN_TILES];
    for (uint i = 0u; i < SM_TILES; ++i)
        for (uint j = 0u; j < SN_TILES; ++j)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(0.0f);

    uint num_blocks = p.K / BLOCK_K;
    uint k_steps    = p.K / BK;

    // W staging assignment: 128 threads cover 64 rows x 32 weights = 2048
    // bf16 outputs; each thread owns one row half-row chunk of 16 weights.
    uint w_row  = tid >> 1u;       // 0..63
    uint w_half = tid & 1u;        // 0 -> elements 0..15, 1 -> 16..31
    uint w_off  = w_half * 16u;

    for (uint kt = 0u; kt < k_steps; ++kt) {
        uint block_idx = kt / 8u;
        uint sub_idx   = kt & 7u;

        // Stage X tile [BM x BK]. WG_SIZE=128 threads each load 16 bf16s.
        for (uint l = 0u; l < (BM * BK) / WG_SIZE; ++l) {
            uint idx = tid + l * WG_SIZE;
            uint row = idx / BK;
            uint col = idx % BK;
            sx[idx] = x[(base_m + row) * p.K + (kt * BK + col)];
        }

        // Stage W tile [BN x BK]: each thread dequantizes 16 weights of one row.
        {
            uint n         = base_n + w_row;
            uint block_off = (n * num_blocks + block_idx) * BLOCK_UINTS;

            vec2  dm   = unpackHalf2x16(w[block_off]);
            float d    = dm.x;
            float dmin = dm.y;
            uint  sw0  = w[block_off + 1u];
            uint  sw1  = w[block_off + 2u];
            uint  sw2  = w[block_off + 3u];

            uint scale, min_v;
            unpack_scale_min(sub_idx, sw0, sw1, sw2, scale, min_v);

            float d_scale  = d    * float(scale);
            float dmin_min = dmin * float(min_v);

            // Q4_K nibble layout: bytes of qs[128] hold two subblocks per
            // 32-byte band. Even sub -> low nibble, odd sub -> high nibble.
            uint byte_base = (sub_idx >> 1u) * 32u;
            uint nib_shift = (sub_idx & 1u) * 4u;

            for (uint j = 0u; j < 16u; ++j) {
                uint e        = w_off + j;
                uint byte_idx = byte_base + e;
                uint qs_word  = w[block_off + 4u + (byte_idx >> 2u)];
                uint qs_byte  = (qs_word >> ((byte_idx & 3u) * 8u)) & 0xFFu;
                uint nibble   = (qs_byte >> nib_shift) & 0x0Fu;
                float val = d_scale * float(nibble) - dmin_min;
                sw[w_row * BK + e] = bfloat16_t(val);
            }
        }

        barrier();

        // Walk K within the staged tile in K_FRAG-wide steps.
        for (uint ks = 0u; ks < K_STEPS_PER_TILE; ++ks) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, K_FRAG, gl_MatrixUseA> mA[SM_TILES];
            coopmat<bfloat16_t, gl_ScopeSubgroup, K_FRAG, N_FRAG, gl_MatrixUseB> mB[SN_TILES];

            for (uint i = 0u; i < SM_TILES; ++i) {
                uint a_off = (sg_m_off + i * M_FRAG) * BK + ks * K_FRAG;
                coopMatLoad(mA[i], sx, a_off, BK, gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint j = 0u; j < SN_TILES; ++j) {
                uint b_off = (sg_n_off + j * N_FRAG) * BK + ks * K_FRAG;
                coopMatLoad(mB[j], sw, b_off, BK, gl_CooperativeMatrixLayoutColumnMajor);
            }

            for (uint i = 0u; i < SM_TILES; ++i)
                for (uint j = 0u; j < SN_TILES; ++j)
                    acc[i][j] = coopMatMulAdd(mA[i], mB[j], acc[i][j]);
        }

        barrier();
    }

    for (uint i = 0u; i < SM_TILES; ++i) {
        for (uint j = 0u; j < SN_TILES; ++j) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator> acc_bf =
                coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(acc[i][j]);
            uint y_row = base_m + sg_m_off + i * M_FRAG;
            uint y_col = base_n + sg_n_off + j * N_FRAG;
            coopMatStore(acc_bf, y, y_row * p.N + y_col, p.N, gl_CooperativeMatrixLayoutRowMajor);
        }
    }
}
