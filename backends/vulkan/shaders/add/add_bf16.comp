// Bf16 broadcast add: out = a + b with b broadcast across len(a)/n_b chunks.
// Bf16 buffers are packed two halves per uint (low=elem 2i, high=elem 2i+1).
// One thread writes one output pair; b halves can land at arbitrary offsets,
// so we read each b half from the appropriate packed slot independently.
#version 450
#include "bf16.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer A { uint a[]; };
layout(set = 0, binding = 1) readonly  buffer B { uint b[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint o[]; };
layout(push_constant) uniform Params { uint n; uint n_b; uint pair_count; } p;

uint load_bf16(uint elem_index) {
    uint pair_index = elem_index >> 1u;
    uint shift      = (elem_index & 1u) * 16u;
    return (b[pair_index] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;

    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint a_pair = a[pair];
    uint a0_bits = a_pair & 0xffffu;
    uint a1_bits = (a_pair >> 16) & 0xffffu;

    uint lo = 0u;
    uint hi = 0u;

    if (i0 < p.n) {
        uint b0_bits = load_bf16(i0 % p.n_b);
        lo = bf16_round(bf16_expand(a0_bits) + bf16_expand(b0_bits));
    }
    if (i1 < p.n) {
        uint b1_bits = load_bf16(i1 % p.n_b);
        hi = bf16_round(bf16_expand(a1_bits) + bf16_expand(b1_bits));
    }

    o[pair] = (hi << 16) | lo;
}
