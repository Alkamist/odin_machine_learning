// a.grad[i] += dy[i] with both packed bf16. One thread per output pair.
#version 450
#include "bf16.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer DY   { uint dy[];   };
layout(set = 0, binding = 1)          buffer DA_A { uint da_a[]; };
layout(push_constant) uniform Params { uint n; uint pair_count; } p;

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;

    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;

    uint dy_pair = dy  [pair];
    uint da_pair = da_a[pair];

    uint lo = da_pair & 0xffffu;
    uint hi = (da_pair >> 16) & 0xffffu;

    if (i0 < p.n) {
        lo = bf16_round(bf16_expand(lo) + bf16_expand(dy_pair & 0xffffu));
    }
    if (i1 < p.n) {
        hi = bf16_round(bf16_expand(hi) + bf16_expand((dy_pair >> 16) & 0xffffu));
    }

    da_a[pair] = (hi << 16) | lo;
}
