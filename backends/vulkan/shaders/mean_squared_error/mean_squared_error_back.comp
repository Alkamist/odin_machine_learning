// dpred[row, i] += (2/sample_size) * (pred - target) * dy[row]. Thread per
// element. Atomic-free.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer P  { float pred[];   };
layout(set = 0, binding = 1) readonly buffer T  { float target[]; };
layout(set = 0, binding = 2) readonly buffer DY { float dy[];     };
layout(set = 0, binding = 3)          buffer DP { float dpred[];  };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = p.count * p.size;
    if (idx >= total) return;
    uint row    = idx / p.size;
    float scale = 2.0 / float(p.size);
    dpred[idx] += scale * (pred[idx] - target[idx]) * dy[row];
}
