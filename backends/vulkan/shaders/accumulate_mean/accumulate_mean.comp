// d[0] += mean(s), single-workgroup tree reduction. Used to keep a running
// loss average on-device so training never needs to sync per-step.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer D { float d[]; };
layout(set = 0, binding = 1) readonly buffer S { float s[]; };

layout(push_constant) uniform Params { uint n; } p;

shared float partial[256];

void main() {
    uint tid = gl_LocalInvocationID.x;

    float local_sum = 0.0;
    for (uint i = tid; i < p.n; i += 256u) {
        local_sum += s[i];
    }
    partial[tid] = local_sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) {
            partial[tid] += partial[tid + stride];
        }
        barrier();
    }

    if (tid == 0u) {
        d[0] += partial[0] / float(p.n);
    }
}
