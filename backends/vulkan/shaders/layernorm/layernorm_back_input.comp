// Backward of layernorm w.r.t. input. Mirrors CPU `layernorm_backward`:
//
//   dnorm_mean      = (1/size) * sum_i (W[i] * dy[c,i])
//   dnorm_norm_mean = (1/size) * sum_i (W[i] * dy[c,i] * norm[c,i])
//   dx[c,i] += (dnorm - dnorm_mean - norm * dnorm_norm_mean) * rstd[c]
//
// One workgroup per row, BLOCK threads, shared-memory reduction over the
// row to get the two means before the per-element write.
#version 450

#define BLOCK 256

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly buffer X  { float x[];    };
layout(set = 0, binding = 1) readonly buffer W  { float w[];    };
layout(set = 0, binding = 2) readonly buffer DY { float dy[];   };
layout(set = 0, binding = 3) readonly buffer M  { float mean[]; };
layout(set = 0, binding = 4) readonly buffer R  { float rstd[]; };
layout(set = 0, binding = 5)          buffer DX { float dx[];   };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

shared float s_dn[BLOCK];
shared float s_dn_norm[BLOCK];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint  base = row * p.size;
    float m    = mean[row];
    float r    = rstd[row];

    float pa = 0.0;
    float pb = 0.0;
    for (uint i = tid; i < p.size; i += BLOCK) {
        float norm  = (x[base + i] - m) * r;
        float dnorm = w[i] * dy[base + i];
        pa += dnorm;
        pb += dnorm * norm;
    }
    s_dn[tid]      = pa;
    s_dn_norm[tid] = pb;
    barrier();

    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) {
            s_dn[tid]      += s_dn[tid + stride];
            s_dn_norm[tid] += s_dn_norm[tid + stride];
        }
        barrier();
    }

    float n               = float(p.size);
    float dnorm_mean      = s_dn[0]      / n;
    float dnorm_norm_mean = s_dn_norm[0] / n;

    for (uint i = tid; i < p.size; i += BLOCK) {
        float norm  = (x[base + i] - m) * r;
        float dnorm = w[i] * dy[base + i];
        float g     = (dnorm - dnorm_mean - norm * dnorm_norm_mean) * r;
        dx[base + i] += g;
    }
}
