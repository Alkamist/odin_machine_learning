// Bf16 broadcast sub: out = a - b. Two halves per uint, one thread per pair.
#version 450
#include "bf16.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly  buffer A { uint a[]; };
layout(set = 0, binding = 1) readonly  buffer B { uint b[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint o[]; };
layout(push_constant) uniform Params { uint n; uint n_b; uint pair_count; } p;

uint load_b(uint elem_index) {
    uint pair = elem_index >> 1u;
    uint shift = (elem_index & 1u) * 16u;
    return (b[pair] >> shift) & 0xffffu;
}

void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= p.pair_count) return;
    uint i0 = 2u * pair;
    uint i1 = i0 + 1u;
    uint a_pair = a[pair];
    uint lo = 0u; uint hi = 0u;
    if (i0 < p.n) lo = bf16_round(bf16_expand(a_pair & 0xffffu)        - bf16_expand(load_b(i0 % p.n_b)));
    if (i1 < p.n) hi = bf16_round(bf16_expand((a_pair >> 16) & 0xffffu) - bf16_expand(load_b(i1 % p.n_b)));
    o[pair] = (hi << 16) | lo;
}
