// Bf16 entropy backward: dp[row, i] += -dy[row] * (log(max(p, 1e-8)) + 1).
// Thread per dp pair. With size even, both halves of a pair belong to the
// same row, so dy[row] is shared across the pair. dy is bf16 too — load by
// row index from packed buffer.
#version 450
#include "bf16.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer P  { uint prob[]; };
layout(set = 0, binding = 1) readonly buffer DY { uint dy[];   };
layout(set = 0, binding = 2)          buffer DP { uint dp[];   };
layout(push_constant) uniform Params { uint count; uint size; uint pair_count; } p;

float load_dy(uint row) {
    uint pair = row >> 1u;
    uint shift = (row & 1u) * 16u;
    return bf16_expand((dy[pair] >> shift) & 0xffffu);
}

void main() {
    uint pi = gl_GlobalInvocationID.x;
    if (pi >= p.pair_count) return;
    uint i0 = 2u * pi;
    uint row = i0 / p.size;

    float dy_v = load_dy(row);

    uint pp = prob[pi];
    uint dpp = dp[pi];

    float p0 = bf16_expand(pp & 0xffffu);
    float p1 = bf16_expand((pp >> 16) & 0xffffu);
    float g0 = -(log(max(p0, 1e-8)) + 1.0);
    float g1 = -(log(max(p1, 1e-8)) + 1.0);

    uint lo = bf16_round(bf16_expand(dpp & 0xffffu)        + dy_v * g0);
    uint hi = bf16_round(bf16_expand((dpp >> 16) & 0xffffu) + dy_v * g1);

    dp[pi] = (hi << 16) | lo;
}
