// Fused bf16 (residual = A + B) followed by rmsnorm-with-weight on the
// residual. Writes both R = a+b (the new residual, used by downstream layer
// ops) and Y = rmsnorm(R) * W. Per row: one combined dispatch instead of
// add+rmsnorm. Stage 1 stores the rounded sum to R and accumulates its
// sum-of-squares; stage 2 re-derives the same rounded sum from A,B (avoids
// an R round-trip) and emits Y.
#version 450
#include "bf16.glsl"
#define WG 256
layout(local_size_x = WG) in;
layout(set = 0, binding = 0) readonly  buffer A { uint a[]; };
layout(set = 0, binding = 1) readonly  buffer B { uint b[]; };
layout(set = 0, binding = 2) readonly  buffer W { uint w[]; };
layout(set = 0, binding = 3) writeonly buffer R { uint r[]; };
layout(set = 0, binding = 4) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params { uint count; uint size; float eps; } p;

shared float partial[WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint pair_count = p.size >> 1u;
    uint pair_base  = (row * p.size) >> 1u;

    float s2 = 0.0;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint ap = a[pair_base + pi];
        uint bp = b[pair_base + pi];
        uint r0_bf = bf16_round(bf16_expand(ap & 0xffffu)         + bf16_expand(bp & 0xffffu));
        uint r1_bf = bf16_round(bf16_expand((ap >> 16) & 0xffffu) + bf16_expand((bp >> 16) & 0xffffu));
        r[pair_base + pi] = (r1_bf << 16) | r0_bf;
        float v0 = bf16_expand(r0_bf);
        float v1 = bf16_expand(r1_bf);
        s2 += v0 * v0 + v1 * v1;
    }
    partial[tid] = s2;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float rstd = inversesqrt(partial[0] / float(p.size) + p.eps);
    barrier();

    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint ap = a[pair_base + pi];
        uint bp = b[pair_base + pi];
        uint wp = w[pi];
        float v0 = bf16_expand(bf16_round(bf16_expand(ap & 0xffffu)         + bf16_expand(bp & 0xffffu)));
        float v1 = bf16_expand(bf16_round(bf16_expand((ap >> 16) & 0xffffu) + bf16_expand((bp >> 16) & 0xffffu)));
        float n0 = v0 * rstd * bf16_expand(wp & 0xffffu);
        float n1 = v1 * rstd * bf16_expand((wp >> 16) & 0xffffu);
        y[pair_base + pi] = (bf16_round(n1) << 16) | bf16_round(n0);
    }
}
