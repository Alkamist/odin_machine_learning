// Bf16 rmsnorm forward. One workgroup per row, size must be even.
#version 450
#include "bf16.glsl"
#define WG 256
layout(local_size_x = WG) in;
layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint y[]; };
layout(push_constant) uniform Params { uint count; uint size; float eps; } p;

shared float partial[WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint pair_count = p.size >> 1u;
    uint pair_base  = (row * p.size) >> 1u;

    float s2 = 0.0;
    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[pair_base + pi];
        float v0 = bf16_expand(xp & 0xffffu);
        float v1 = bf16_expand((xp >> 16) & 0xffffu);
        s2 += v0 * v0 + v1 * v1;
    }
    partial[tid] = s2;
    barrier();
    for (uint stride = WG / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    float rstd = inversesqrt(partial[0] / float(p.size) + p.eps);
    barrier();

    for (uint pi = tid; pi < pair_count; pi += WG) {
        uint xp = x[pair_base + pi];
        uint wp = w[pi];
        float v0 = bf16_expand(xp & 0xffffu)         * rstd * bf16_expand(wp & 0xffffu);
        float v1 = bf16_expand((xp >> 16) & 0xffffu) * rstd * bf16_expand((wp >> 16) & 0xffffu);
        y[pair_base + pi] = (bf16_round(v1) << 16) | bf16_round(v0);
    }
}
