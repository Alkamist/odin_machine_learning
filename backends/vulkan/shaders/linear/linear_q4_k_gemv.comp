// Q4_K GEMV specialization for M=1 decode-shape forwards. One workgroup per
// `ROWS_PER_WG` output rows. Q4_K block layout (144 bytes / 36 uints / 256
// weights per block):
//   d      fp16     low halfword of uint[0]
//   dmin   fp16     high halfword of uint[0]
//   scales 12 bytes uint[1..3] (six-bit scale + six-bit min for 8 sub-blocks
//                               of 32 weights each, packed per
//                               get_scale_min_k4 in ggml/src/ggml-quants.c)
//   qs     128 byte uint[4..35] (4-bit quants, two nibbles per byte; the
//                                low nibble of byte b is element
//                                ((b/32)*64 + (b%32)) of the block, the
//                                high nibble is +32 from that)
//
// Dequant per element e in block:
//   w(e) = d * scale[e/32] * quant(e) - dmin * min[e/32]
//
// Layout:
//   x [1, K] bf16, packed (two halves per uint)
//   w [N, K] Q4_K, raw bytes read as a uint stream (K % 256 == 0)
//   y [1, N] bf16, packed
// Requires: K % 256 == 0; N % ROWS_PER_WG == 0.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "bf16.glsl"

#define WG          32
#define ROWS_PER_WG  2
#define BLOCK_K    256
#define BLOCK_UINTS 36   // 144 bytes / 4

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint y[]; };

layout(push_constant) uniform Params {
    uint M;
    uint K;
    uint N;
} p;

// Unpack the `sub`-th sub-block's 6-bit scale and 6-bit min from the 12-byte
// packed scales region. Mirrors `get_scale_min_k4` from ggml-quants.c.
//
//   bytes 0..3  : low 6 bits of scales 0..3   (and high 2 bits of scales 4..7
//                                              in the upper 2 bits)
//   bytes 4..7  : low 6 bits of mins   0..3   (and high 2 bits of mins   4..7
//                                              in the upper 2 bits)
//   bytes 8..11 : low 4 bits of scales 4..7 in low nibble,
//                 low 4 bits of mins   4..7 in high nibble
void unpack_scale_min(uint sub, uint sw0, uint sw1, uint sw2, out uint scale, out uint min_v) {
    if (sub < 4u) {
        uint shift = sub * 8u;
        scale = (sw0 >> shift) & 0x3Fu;
        min_v = (sw1 >> shift) & 0x3Fu;
    } else {
        uint shift = (sub - 4u) * 8u;
        uint b_low = (sw2 >> shift) & 0xFFu;
        uint b_sc  = (sw0 >> shift) & 0xFFu;
        uint b_mn  = (sw1 >> shift) & 0xFFu;
        scale = (b_low & 0x0Fu) | ((b_sc >> 6u) << 4u);
        min_v = (b_low >>  4u)  | ((b_mn >> 6u) << 4u);
    }
}

void main() {
    uint group_idx = gl_WorkGroupID.x;
    uint n_base    = group_idx * ROWS_PER_WG;
    uint tid       = gl_LocalInvocationID.x;

    uint num_blocks = p.K / BLOCK_K;

    float acc[ROWS_PER_WG];
    for (uint r = 0u; r < ROWS_PER_WG; ++r) acc[r] = 0.0;

    for (uint b = 0u; b < num_blocks; ++b) {
        for (uint r = 0u; r < ROWS_PER_WG; ++r) {
            uint n = n_base + r;
            if (n >= p.N) continue;

            uint block_off = (n * num_blocks + b) * BLOCK_UINTS;

            vec2  dm   = unpackHalf2x16(w[block_off]);
            float d    = dm.x;
            float dmin = dm.y;
            uint  sw0  = w[block_off + 1u];
            uint  sw1  = w[block_off + 2u];
            uint  sw2  = w[block_off + 3u];

            // 8 elements per block per thread, one per sub-block.
            for (uint s = 0u; s < 8u; ++s) {
                uint scale, min_v;
                unpack_scale_min(s, sw0, sw1, sw2, scale, min_v);

                uint e        = s * 32u + tid;
                uint byte_idx = (s >> 1u) * 32u + tid;
                uint shift    = (s & 1u) * 4u;
                uint qs_word  = w[block_off + 4u + (byte_idx >> 2u)];
                uint qs_byte  = (qs_word >> ((byte_idx & 3u) * 8u)) & 0xFFu;
                uint nibble   = (qs_byte >> shift) & 0x0Fu;

                uint k    = b * BLOCK_K + e;
                uint pkx  = x[k >> 1u];
                float xv  = ((k & 1u) == 0u)
                    ? bf16_expand( pkx        & 0xffffu)
                    : bf16_expand((pkx >> 16) & 0xffffu);

                acc[r] += (d * float(scale)) * (float(nibble) * xv) - (dmin * float(min_v)) * xv;
            }
        }
    }

    float total[ROWS_PER_WG];
    for (uint r = 0u; r < ROWS_PER_WG; ++r) total[r] = subgroupAdd(acc[r]);

    if (tid == 0u) {
        for (uint pair = 0u; pair < ROWS_PER_WG / 2u; ++pair) {
            uint n_lo = n_base + 2u * pair;
            if (n_lo >= p.N) break;
            uint n_hi = n_lo + 1u;
            uint lo_b = bf16_round(total[2u * pair]);
            uint hi_b = (n_hi < p.N) ? bf16_round(total[2u * pair + 1u]) : 0u;
            y[n_lo >> 1u] = (hi_b << 16) | lo_b;
        }
    }
}
