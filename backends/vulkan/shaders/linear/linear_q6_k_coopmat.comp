// Q6_K weight x bf16 activation GEMM using cooperative matrix (tensor cores).
// Same shape and shared-memory staging as linear_q4_k_coopmat.comp; differs
// only in how each W weight is decoded.
//
// Per Q6_K block (210 bytes / 256 weights, byte-addressed via uint stream):
//   ql[128]      bytes   0..127  (low 4 bits per quant, two nibbles per byte)
//   qh[64]       bytes 128..191  (upper 2 bits per quant, four per byte)
//   scales[16]   bytes 192..207  (i8 sub-block scales, one per 16 weights)
//   d            bytes 208..209  (fp16 super-block scale)
//
// For element e in block:   q(e) = (ql_nibble | (qh_2bits << 4)) - 32
//                           w(e) = d * scales[e/16] * q(e)
//
// Constraints: M % BM == 0, N % BN == 0, K % BLOCK_K (256) == 0,
//              subgroup size == 32.
#version 460

#extension GL_KHR_cooperative_matrix     : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic  : require
#extension GL_EXT_shader_16bit_storage   : require
#extension GL_EXT_bfloat16               : require

#define BM            64
#define BN            64
#define BK            32   // one (h, quadrant) pair per K-step (32 weights)
#define M_FRAG        16
#define N_FRAG        16
#define K_FRAG        16
#define SUB_M         2
#define SUB_N         2
#define SM_TILES      (BM / (M_FRAG * SUB_M))      // 2
#define SN_TILES      (BN / (N_FRAG * SUB_N))      // 2
#define K_STEPS_PER_TILE (BK / K_FRAG)             // 2
#define SUBGROUP_SIZE 32
#define WG_SIZE       (SUB_M * SUB_N * SUBGROUP_SIZE)   // 128

#define BLOCK_K       256
#define BLOCK_BYTES   210

layout(local_size_x = WG_SIZE) in;

layout(set = 0, binding = 0) readonly  buffer X { bfloat16_t x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint        w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { bfloat16_t y[]; };

layout(push_constant) uniform Params {
    uint M;
    uint K;
    uint N;
} p;

shared bfloat16_t sx[BM * BK];
shared bfloat16_t sw[BN * BK];

uint load_byte(uint byte_offset) {
    uint u = w[byte_offset >> 2u];
    return (u >> ((byte_offset & 3u) * 8u)) & 0xFFu;
}

int load_i8(uint byte_offset) {
    uint b = load_byte(byte_offset);
    int  s = int(b);
    if ((b & 0x80u) != 0u) s -= 256;
    return s;
}

void main() {
    uint wg_m = gl_WorkGroupID.x;
    uint wg_n = gl_WorkGroupID.y;
    uint sg   = gl_SubgroupID;
    uint sg_m = sg / SUB_N;
    uint sg_n = sg % SUB_N;
    uint tid  = gl_LocalInvocationID.x;

    uint base_m   = wg_m * BM;
    uint base_n   = wg_n * BN;
    uint sg_m_off = sg_m * (SM_TILES * M_FRAG);
    uint sg_n_off = sg_n * (SN_TILES * N_FRAG);

    coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>
        acc[SM_TILES][SN_TILES];
    for (uint i = 0u; i < SM_TILES; ++i)
        for (uint j = 0u; j < SN_TILES; ++j)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(0.0f);

    uint num_blocks = p.K / BLOCK_K;
    uint k_steps    = p.K / BK;

    uint w_row  = tid >> 1u;       // 0..63
    uint w_half = tid & 1u;        // 0 -> elements 0..15, 1 -> 16..31
    uint w_off  = w_half * 16u;    // 0 or 16

    for (uint kt = 0u; kt < k_steps; ++kt) {
        uint block_idx     = kt / 8u;
        uint sub_step      = kt & 7u;          // 0..7 (which 32-element step in the block)
        uint h             = sub_step >> 2u;   // 0 or 1
        uint quad          = sub_step & 3u;    // 0..3

        // Stage X tile [BM x BK].
        for (uint l = 0u; l < (BM * BK) / WG_SIZE; ++l) {
            uint idx = tid + l * WG_SIZE;
            uint row = idx / BK;
            uint col = idx % BK;
            sx[idx] = x[(base_m + row) * p.K + (kt * BK + col)];
        }

        // Stage W tile [BN x BK]: each thread dequantizes 16 weights of one row.
        {
            uint n         = base_n + w_row;
            uint block_off = (n * num_blocks + block_idx) * BLOCK_BYTES;

            float d = unpackHalf2x16(
                load_byte(block_off + 208u) | (load_byte(block_off + 209u) << 8u)
            ).x;

            // All 16 weights covered by this thread share one 16-element
            // sub-block (w_off is 0 or 16, both 16-aligned starts).
            uint e_first = h * 128u + quad * 32u + w_off;
            uint sub_idx = e_first >> 4u;     // /16
            int  scale_i8 = load_i8(block_off + 192u + sub_idx);
            float d_scale = d * float(scale_i8);

            // ql / qh byte offsets are constant in `j` since l = w_off + j and
            // (w_off..w_off+15) all sit in the same 32-byte ql/qh band.
            uint ql_band_off = h * 64u + (quad & 1u) * 32u;
            uint ql_nib_shift = (quad >> 1u) * 4u;
            uint qh_band_off  = 128u + h * 32u;
            uint qh_bit_shift = quad * 2u;

            for (uint j = 0u; j < 16u; ++j) {
                uint l_in_band = w_off + j;
                uint ql_byte = load_byte(block_off + ql_band_off + l_in_band);
                uint qh_byte = load_byte(block_off + qh_band_off + l_in_band);
                uint ql_nib  = (ql_byte >> ql_nib_shift) & 0x0Fu;
                uint qh_2b   = (qh_byte >> qh_bit_shift) & 0x03u;
                int  q       = int(ql_nib | (qh_2b << 4u)) - 32;
                float val    = d_scale * float(q);
                sw[w_row * BK + (w_off + j)] = bfloat16_t(val);
            }
        }

        barrier();

        for (uint ks = 0u; ks < K_STEPS_PER_TILE; ++ks) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, K_FRAG, gl_MatrixUseA> mA[SM_TILES];
            coopmat<bfloat16_t, gl_ScopeSubgroup, K_FRAG, N_FRAG, gl_MatrixUseB> mB[SN_TILES];

            for (uint i = 0u; i < SM_TILES; ++i) {
                uint a_off = (sg_m_off + i * M_FRAG) * BK + ks * K_FRAG;
                coopMatLoad(mA[i], sx, a_off, BK, gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint j = 0u; j < SN_TILES; ++j) {
                uint b_off = (sg_n_off + j * N_FRAG) * BK + ks * K_FRAG;
                coopMatLoad(mB[j], sw, b_off, BK, gl_CooperativeMatrixLayoutColumnMajor);
            }

            for (uint i = 0u; i < SM_TILES; ++i)
                for (uint j = 0u; j < SN_TILES; ++j)
                    acc[i][j] = coopMatMulAdd(mA[i], mB[j], acc[i][j]);
        }

        barrier();
    }

    for (uint i = 0u; i < SM_TILES; ++i) {
        for (uint j = 0u; j < SN_TILES; ++j) {
            coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator> acc_bf =
                coopmat<bfloat16_t, gl_ScopeSubgroup, M_FRAG, N_FRAG, gl_MatrixUseAccumulator>(acc[i][j]);
            uint y_row = base_m + sg_m_off + i * M_FRAG;
            uint y_col = base_n + sg_n_off + j * N_FRAG;
            coopMatStore(acc_bf, y, y_row * p.N + y_col, p.N, gl_CooperativeMatrixLayoutRowMajor);
        }
    }
}
