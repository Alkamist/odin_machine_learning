// Q4_K weight x Q8_1 activation GEMV using packed-4x8 integer dot products.
// Mirrors `linear_q4_k_gemv.comp`'s WG/ROWS shape; the difference is that
// the activation is pre-quantized to Q8_1 (see quantize_q8_1_bf16.comp) so
// the inner loop can fold 4 multiply-adds into one `dotPacked4x8EXT`.
//
// Per Q4_K subblock s (32 elements, shares Q8_1 block index `b*8 + s`):
//   sum_e w(e)*x(e) = d * scale_s * d_q8 * int_dot(q4, q8)
//                    - dmin * min_s * s_q8
// where (d_q8, s_q8) = ds packed in the Q8_1 block header.
//
// Layout:
//   x [num_blocks * 8] Q8_1 blocks, one block = 9 uints (uint0=ds, uint1..8=qs)
//   w [N, K] Q4_K, raw bytes read as a uint stream (K % 256 == 0)
//   y [1, N] bf16, packed
// Requires: K % 256 == 0; N % ROWS_PER_WG == 0.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_integer_dot_product       : require
#include "bf16.glsl"

#define WG          32
#define ROWS_PER_WG  2
#define BLOCK_K    256
#define BLOCK_UINTS 36   // 144 bytes / 4
#define Q8_BLOCK_UINTS 9 // 36 bytes / 4

layout(local_size_x = WG) in;

layout(set = 0, binding = 0) readonly  buffer X { uint x[]; };
layout(set = 0, binding = 1) readonly  buffer W { uint w[]; };
layout(set = 0, binding = 2) writeonly buffer Y { uint y[]; };

layout(push_constant) uniform Params {
    uint M;
    uint K;
    uint N;
} p;

// Same scale/min unpack as linear_q4_k_gemv.comp; mirrors
// `get_scale_min_k4` in ggml-quants.c.
void unpack_scale_min(uint sub, uint sw0, uint sw1, uint sw2, out uint scale, out uint min_v) {
    if (sub < 4u) {
        uint shift = sub * 8u;
        scale = (sw0 >> shift) & 0x3Fu;
        min_v = (sw1 >> shift) & 0x3Fu;
    } else {
        uint shift = (sub - 4u) * 8u;
        uint b_low = (sw2 >> shift) & 0xFFu;
        uint b_sc  = (sw0 >> shift) & 0xFFu;
        uint b_mn  = (sw1 >> shift) & 0xFFu;
        scale = (b_low & 0x0Fu) | ((b_sc >> 6u) << 4u);
        min_v = (b_low >>  4u)  | ((b_mn >> 6u) << 4u);
    }
}

void main() {
    uint group_idx = gl_WorkGroupID.x;
    uint n_base    = group_idx * ROWS_PER_WG;
    uint tid       = gl_LocalInvocationID.x;

    uint num_blocks = p.K / BLOCK_K;

    float acc[ROWS_PER_WG];
    for (uint r = 0u; r < ROWS_PER_WG; ++r) acc[r] = 0.0;

    // Each thread covers two of the 64 packed-4x8 chunks per Q4_K block.
    // chunk -> subblock (sub = chunk / 8) and within-subblock offset
    // (inner = chunk % 8, in 4-element units).
    for (uint b = 0u; b < num_blocks; ++b) {
        // Q8_1 ds for the 8 subblocks of this Q4_K block. Reused by both rows.
        uint q8_block_base = b * 8u;

        for (uint r = 0u; r < ROWS_PER_WG; ++r) {
            uint n = n_base + r;
            if (n >= p.N) continue;

            uint block_off = (n * num_blocks + b) * BLOCK_UINTS;

            vec2  dm   = unpackHalf2x16(w[block_off]);
            float d    = dm.x;
            float dmin = dm.y;
            uint  sw0  = w[block_off + 1u];
            uint  sw1  = w[block_off + 2u];
            uint  sw2  = w[block_off + 3u];

            float row_acc = 0.0;

            for (uint chunk_pair = 0u; chunk_pair < 2u; ++chunk_pair) {
                uint chunk = tid + chunk_pair * 32u;
                uint sub   = chunk >> 3u;
                uint inner = chunk & 7u;

                // Q4_K nibble word: 4 contiguous nibbles for subblock `sub`.
                // Bytes are laid out as (sub>>1)*32 + j, paired across sub & sub|1
                // via the high/low nibble of each byte.
                uint nib_word = w[block_off + 4u + (sub >> 1u) * 8u + inner];
                uint shift    = (sub & 1u) * 4u;
                int  q4_packed = int((nib_word >> shift) & 0x0F0F0F0Fu);

                uint q8_off = (q8_block_base + sub) * Q8_BLOCK_UINTS;
                int  q8_packed = int(x[q8_off + 1u + inner]);

                int   int_dot = dotPacked4x8EXT(q4_packed, q8_packed);
                vec2  q8_ds   = unpackHalf2x16(x[q8_off]);

                uint scale, min_v;
                unpack_scale_min(sub, sw0, sw1, sw2, scale, min_v);

                row_acc += d * float(scale) * q8_ds.x * float(int_dot);

                // Per-subblock dmin * min * s_q8 correction, applied once per
                // subblock. The 8 chunks within a subblock map to inner=0..7;
                // pin the correction to inner==0 to avoid double-counting.
                if (inner == 0u) {
                    row_acc -= dmin * float(min_v) * q8_ds.y;
                }
            }

            acc[r] += row_acc;
        }
    }

    float total[ROWS_PER_WG];
    for (uint r = 0u; r < ROWS_PER_WG; ++r) total[r] = subgroupAdd(acc[r]);

    if (tid == 0u) {
        for (uint pair = 0u; pair < ROWS_PER_WG / 2u; ++pair) {
            uint n_lo = n_base + 2u * pair;
            if (n_lo >= p.N) break;
            uint n_hi = n_lo + 1u;
            uint lo_b = bf16_round(total[2u * pair]);
            uint hi_b = (n_hi < p.N) ? bf16_round(total[2u * pair + 1u]) : 0u;
            y[n_lo >> 1u] = (hi_b << 16) | lo_b;
        }
    }
}
