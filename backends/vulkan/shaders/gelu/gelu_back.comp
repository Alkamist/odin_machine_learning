// Backward of tanh-approx GELU. Mirrors CPU `gelu_backward`:
//   dx[i] += local_grad(x[i]) * dy[i]
// where local_grad(x) is the analytical derivative of
//   gelu(x) = 0.5 * x * (1 + tanh(GELU_SCALE * (x + 0.044715*x^3))).
#version 450

#define GELU_SCALE 0.7978845608028654

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X  { float x[];  };
layout(set = 0, binding = 1)          buffer DX { float dx[]; };
layout(set = 0, binding = 2) readonly buffer DY { float dy[]; };

layout(push_constant) uniform Params {
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    float v        = x[i];
    float cube     = 0.044715 * v * v * v;
    float t_arg    = GELU_SCALE * (v + cube);
    float t_out    = tanh(t_arg);
    float c_out    = cosh(t_arg);
    float sech2    = 1.0 / (c_out * c_out);
    float local_g  = 0.5 * (1.0 + t_out)
                   + v * 0.5 * sech2 * GELU_SCALE * (1.0 + 3.0 * 0.044715 * v * v);

    dx[i] += local_g * dy[i];
}
