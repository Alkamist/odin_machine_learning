// dst <- (1 - alpha) * dst + alpha * source, in place. Side-effecting
// utility used for EMA of model parameters; not part of the autograd graph.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer D { float d[]; };
layout(set = 0, binding = 1) readonly buffer S { float s[]; };

layout(push_constant) uniform Params {
    uint  n;
    float alpha;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    d[i] = (1.0 - p.alpha) * d[i] + p.alpha * s[i];
}
