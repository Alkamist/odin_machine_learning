// Fill a buffer with zeros. Used to clear gradient buffers between training
// steps before the backward sweep accumulates into them.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Params {
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    y[i] = 0.0;
}
