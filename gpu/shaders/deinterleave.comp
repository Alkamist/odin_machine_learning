// out[i] = in[i * column_count + column]
// Pulls one of `column_count` interleaved channels out of the trailing dim.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer In  { float a[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float b[]; };

layout(push_constant) uniform Params {
    uint n_out;        // total output element count
    uint column;
    uint column_count;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n_out) return;
    b[i] = a[i * p.column_count + p.column];
}
