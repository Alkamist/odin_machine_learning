// Step 2 of attention backward: gradient w.r.t. V.
//
//   dV[t2, h, d] += sum_{t : t >= t2 (if causal)} post[t, h, t2] * dout[t, h, d]
//
// post is precomputed by attention_back_post; reading it instead of
// recomputing makes this O(T*H*D*T) rather than O(T^3*H*D^2). Thread per
// (t2, h, d); accumulates into d_qkv at the V slot.
#version 450

layout(local_size_x = 8, local_size_y = 4, local_size_z = 8) in;

layout(set = 0, binding = 0) readonly buffer Post { float post[];  };
layout(set = 0, binding = 1) readonly buffer DOut { float dout[];  };
layout(set = 0, binding = 2)          buffer DIn  { float d_qkv[]; };

layout(push_constant) uniform Params {
    uint token_count;
    uint head_count;
    uint head_size;
    uint causal;
} p;

void main() {
    uint t2 = gl_GlobalInvocationID.x;
    uint h  = gl_GlobalInvocationID.y;
    uint d  = gl_GlobalInvocationID.z;
    if (t2 >= p.token_count || h >= p.head_count || d >= p.head_size) return;

    uint output_size = p.head_count * p.head_size;
    uint input_size  = 3u * output_size;

    uint t_start = (p.causal != 0u) ? t2 : 0u;

    float acc = 0.0;
    for (uint t = t_start; t < p.token_count; t++) {
        uint p_off    = t * p.head_count * p.token_count + h * p.token_count + t2;
        uint dout_off = t * output_size + h * p.head_size;
        acc += post[p_off] * dout[dout_off + d];
    }

    uint v_off = t2 * input_size + h * p.head_size + 2u * output_size;
    d_qkv[v_off + d] += acc;
}
