// Causal mask backward: gradient passes through unchanged at lower-triangle
// (and diagonal) positions, blocked at upper-triangle positions.
//
//   dx: [..., T, T]   accumulate
//   dy: [..., T, T]   upstream gradient
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer DX { float dx[]; };
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; };

layout(push_constant) uniform Params {
    uint total;
    uint T;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.total) return;

    uint within = idx % (p.T * p.T);
    uint t1 = within / p.T;
    uint t2 = within % p.T;

    if (t2 <= t1) {
        dx[idx] += dy[idx];
    }
}
