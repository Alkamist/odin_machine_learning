// Adam(W) parameter update, in-place, matches CPU `ml.update`:
//   m = beta1*m + (1-beta1)*g
//   v = beta2*v + (1-beta2)*g*g
//   x = x*(1 - lr*wd) - lr * (m / bc1) / (sqrt(v / bc2) + eps)
//   g = 0
// where bc1 = 1 - beta1^iter, bc2 = 1 - beta2^iter (computed host-side).
//
// One thread per element, 1D dispatch.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) buffer G { float g[]; };
layout(set = 0, binding = 2) buffer M { float m[]; };
layout(set = 0, binding = 3) buffer V { float v[]; };

layout(push_constant) uniform Params {
    uint  n;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float wd;
    float bc1;
    float bc2;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    float grad = g[i];
    float mi = p.beta1 * m[i] + (1.0 - p.beta1) * grad;
    float vi = p.beta2 * v[i] + (1.0 - p.beta2) * grad * grad;
    m[i] = mi;
    v[i] = vi;

    float m_hat = mi / p.bc1;
    float v_hat = vi / p.bc2;

    x[i] = x[i] * (1.0 - p.lr * p.wd) - p.lr * m_hat / (sqrt(v_hat) + p.eps);
    g[i] = 0.0;
}
