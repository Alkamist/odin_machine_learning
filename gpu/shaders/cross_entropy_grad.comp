// Fused cross-entropy + softmax backward. Reads logits + targets, writes
// per-row loss and dlogits = (softmax(logits) - one_hot(targets)) / N.
//
// One workgroup per row, BLOCK threads, two shared-memory reductions
// (max for numerical stability, then sum for the softmax denominator).
// Mirrors CPU `ml.cross_entropy` followed by `cross_entropy_backward`
// with upstream_gradient = 1/N.
//
// Output dlogits is **assigned**, not accumulated — the cross-entropy is
// the head of the backward sweep, so its dlogits buffer starts here.
#version 450

#define BLOCK 256

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly  buffer X    { float logits[];   };
layout(set = 0, binding = 1) readonly  buffer T    { uint  targets[];  };
layout(set = 0, binding = 2) writeonly buffer DX   { float dlogits[];  };
layout(set = 0, binding = 3) writeonly buffer Loss { float loss_row[]; };

layout(push_constant) uniform Params {
    uint count;
    uint class_size;
} p;

shared float s_max[BLOCK];
shared float s_sum[BLOCK];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint base = row * p.class_size;

    // Phase 1: per-row max for numerical stability.
    float local_max = -3.402823e38;
    for (uint i = tid; i < p.class_size; i += BLOCK) {
        float v = logits[base + i];
        if (v > local_max) local_max = v;
    }
    s_max[tid] = local_max;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_max[tid] = max(s_max[tid], s_max[tid + stride]);
        barrier();
    }
    float max_v = s_max[0];
    barrier();

    // Phase 2: sum of exp(logits - max).
    float local_sum = 0.0;
    for (uint i = tid; i < p.class_size; i += BLOCK) {
        local_sum += exp(logits[base + i] - max_v);
    }
    s_sum[tid] = local_sum;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_sum[tid] += s_sum[tid + stride];
        barrier();
    }
    float exp_sum = s_sum[0];
    float inv_sum = exp_sum == 0.0 ? 0.0 : (1.0 / exp_sum);
    barrier();

    // Phase 3: per-element dlogits and per-row loss.
    uint  target = targets[row];
    float scale  = 1.0 / float(p.count);
    for (uint i = tid; i < p.class_size; i += BLOCK) {
        float prob = exp(logits[base + i] - max_v) * inv_sum;
        float ind  = (i == target) ? 1.0 : 0.0;
        dlogits[base + i] = (prob - ind) * scale;
    }

    if (tid == 0u) {
        // -log(softmax[target]) = max + log(sum) - logits[target]
        loss_row[row] = max_v + log(exp_sum) - logits[base + target];
    }
}
