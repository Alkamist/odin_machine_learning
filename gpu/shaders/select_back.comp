// Backward of `select` (embedding lookup).
//   forward:  out[i, j] = table[indices[i], j]
//   backward: table.grad[v, j] += sum_{i : indices[i] == v} dy[i, j]
//
// Thread per (vocab_id, j); inner loop scans the indices array. Avoids
// f32 atomics entirely — vocab × n × size is cheap at typical training
// sizes (vocab × seq_len × embed → low MFLOP).
#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer IDX { uint  indices[]; };
layout(set = 0, binding = 1) readonly buffer DY  { float dy[];      }; // [n, size]
layout(set = 0, binding = 2)          buffer DT  { float dtable[];  }; // [vocab, size]

layout(push_constant) uniform Params {
    uint vocab;
    uint n_indices;
    uint size;
} p;

void main() {
    uint v = gl_GlobalInvocationID.x;
    uint j = gl_GlobalInvocationID.y;
    if (v >= p.vocab || j >= p.size) return;

    float acc = 0.0;
    for (uint i = 0u; i < p.n_indices; i++) {
        if (indices[i] == v) {
            acc += dy[i * p.size + j];
        }
    }
    dtable[v * p.size + j] += acc;
}
