// dx[i] += y[i] * dy[i] where y = exp(x). Thread per element.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Y  { float y[];  };
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 2)          buffer DX { float dx[]; };
layout(push_constant) uniform Params { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    dx[i] += y[i] * dy[i];
}
