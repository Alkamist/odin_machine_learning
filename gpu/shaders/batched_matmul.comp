// Forward of `batched_matmul`. C[bi, i, j] = sum_k A[bi, i, k] * B[bi, k, j].
// One thread per output element; reduction over k in the inner loop. Output
// is freshly allocated and zeroed by the backend, so we write `=` not `+=`.
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer A { float a[]; };
layout(set = 0, binding = 1) readonly  buffer B { float b[]; };
layout(set = 0, binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform Params {
    uint batch_count;
    uint m;
    uint k;
    uint n;
} p;

void main() {
    uint i  = gl_GlobalInvocationID.x;
    uint j  = gl_GlobalInvocationID.y;
    uint bi = gl_GlobalInvocationID.z;
    if (i >= p.m || j >= p.n || bi >= p.batch_count) return;

    uint a_base = bi * p.m * p.k + i * p.k;
    uint b_base = bi * p.k * p.n;

    float acc = 0.0;
    for (uint kk = 0; kk < p.k; ++kk) {
        acc += a[a_base + kk] * b[b_base + kk * p.n + j];
    }
    c[bi * p.m * p.n + i * p.n + j] = acc;
}
