// 3-D permute backward.
//   src: output gradient, shape (out_d0, out_d1, out_d2) — the forward's output shape.
//   dst: input gradient,  shape (in_d0,  in_d1,  in_d2)  — accumulated.
//
// Math: dst[s0, s1, s2] += src[i0, i1, i2]
// where s[axes[k]] = i_k (same axes as forward; permute is a bijection
// so each output index maps to a unique input index, no race).
//
// One thread per output-grad element.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Src { float src[]; };
layout(set = 0, binding = 1)          buffer Dst { float dst[]; };

layout(push_constant) uniform Params {
    uint out_d0, out_d1, out_d2;
    uint in_d1,  in_d2;
    uint axes_0, axes_1, axes_2;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = p.out_d0 * p.out_d1 * p.out_d2;
    if (idx >= total) return;

    uint i2 = idx % p.out_d2;
    uint t  = idx / p.out_d2;
    uint i1 = t   % p.out_d1;
    uint i0 = t   / p.out_d1;

    uint si[3];
    si[p.axes_0] = i0;
    si[p.axes_1] = i1;
    si[p.axes_2] = i2;

    uint dst_idx = (si[0] * p.in_d1 + si[1]) * p.in_d2 + si[2];
    dst[dst_idx] += src[idx];
}
