// Backward of rope. The forward rotation
//   x' =  x*cos - y*sin
//   y' =  x*sin + y*cos
// is an orthogonal 2D rotation, so its Jacobian is the transpose:
//   dx +=  dx'*cos + dy'*sin
//   dy += -dx'*sin + dy'*cos
// (Same sin/cos schedule as the forward kernel.)
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)          buffer DX { float dx[]; };
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; };

layout(push_constant) uniform Params {
    uint  token_count;
    uint  head_count;
    uint  head_size;
    float base;
} p;

void main() {
    uint gid     = gl_GlobalInvocationID.x;
    uint half_hs = p.head_size / 2u;
    uint total   = p.token_count * p.head_count * half_hs;
    if (gid >= total) return;

    uint pair_idx = gid % half_hs;
    uint hg       = gid / half_hs;
    uint head     = hg % p.head_count;
    uint pos      = hg / p.head_count;

    float exponent = float(pair_idx * 2u) / float(p.head_size);
    float theta    = float(pos) / pow(p.base, exponent);
    float c_v      = cos(theta);
    float s_v      = sin(theta);

    uint head_offset = pos * p.head_count * p.head_size + head * p.head_size;
    uint i_lo = head_offset + pair_idx * 2u;
    uint i_hi = i_lo + 1u;

    float gx = dy[i_lo];
    float gy = dy[i_hi];

    dx[i_lo] +=  gx * c_v + gy * s_v;
    dx[i_hi] += -gx * s_v + gy * c_v;
}
