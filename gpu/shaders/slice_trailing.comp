// Slice along the trailing dim, preserving leading shape.
//   in:  [leading, trailing]
//   out: [leading, new_trailing]   where new_trailing = end - start
// One thread per output element.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer In  { float a[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float b[]; };

layout(push_constant) uniform Params {
    uint leading;
    uint trailing;
    uint new_trailing;
    uint start;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = p.leading * p.new_trailing;
    if (gid >= total) return;
    uint r = gid / p.new_trailing;
    uint i = gid % p.new_trailing;
    b[r * p.new_trailing + i] = a[r * p.trailing + p.start + i];
}
