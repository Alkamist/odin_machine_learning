// a.grad[i] += dy[i]. Thread per output.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer DY   { float dy[];   };
layout(set = 0, binding = 1)          buffer DA_A { float da_a[]; };
layout(push_constant) uniform Params { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    da_a[i] += dy[i];
}
