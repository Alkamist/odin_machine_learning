// dx[i] += dy[i] when min_val <= x[i] <= max_val (CPU semantics — gradient
// passes through the saturated edges). Thread per element.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X  { float x[];  };
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 2)          buffer DX { float dx[]; };
layout(push_constant) uniform Params {
    uint  n;
    float min_val;
    float max_val;
} p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float xv = x[i];
    if (xv >= p.min_val && xv <= p.max_val) {
        dx[i] += dy[i];
    }
}
