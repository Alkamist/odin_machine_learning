// dp[row, i] += -dy[row] * (log(max(p, 1e-8)) + 1). Thread per element.
#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer P  { float prob[]; };
layout(set = 0, binding = 1) readonly buffer DY { float dy[];   };
layout(set = 0, binding = 2)          buffer DP { float dp[];   };

layout(push_constant) uniform Params {
    uint count;
    uint size;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = p.count * p.size;
    if (idx >= total) return;
    uint row    = idx / p.size;
    float pv    = prob[idx];
    float p_safe = max(pv, 1e-8);
    dp[idx] += dy[row] * (-(log(p_safe) + 1.0));
}
