// dx[i] += dy[i] where x[i] > 0. Thread per element.
#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer X  { float x[];  };
layout(set = 0, binding = 1) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 2)          buffer DX { float dx[]; };
layout(push_constant) uniform Params { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    if (x[i] > 0.0) dx[i] += dy[i];
}
