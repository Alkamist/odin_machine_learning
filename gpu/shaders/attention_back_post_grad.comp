// Step 1 of attention backward.
//
//   post_grad[t, h, t2] = sum_d V[t2, h, d] * dout[t, h, d]
//
// One thread per (t, h, t2); reduction over head_size. No atomics.
//
// Layout of post / post_grad: [token_count, head_count, token_count] —
//   index = t * head_count * token_count + h * token_count + t2
#version 450

layout(local_size_x = 32, local_size_y = 4) in;

layout(set = 0, binding = 0) readonly  buffer In   { float qkv[];   };
layout(set = 0, binding = 1) readonly  buffer DOut { float dout[];  };
layout(set = 0, binding = 2) writeonly buffer PG   { float pgrad[]; };

layout(push_constant) uniform Params {
    uint  token_count;
    uint  head_count;
    uint  head_size;
    uint  causal;
} p;

void main() {
    uint t  = gl_GlobalInvocationID.x;
    uint h  = gl_GlobalInvocationID.y;
    uint t2 = gl_GlobalInvocationID.z;
    if (t >= p.token_count || h >= p.head_count || t2 >= p.token_count) return;

    uint output_size = p.head_count * p.head_size;
    uint input_size  = 3u * output_size;

    uint max_t2 = (p.causal != 0u) ? t : (p.token_count - 1u);
    uint pg_off = t * p.head_count * p.token_count + h * p.token_count + t2;

    if (t2 > max_t2) {
        pgrad[pg_off] = 0.0;
        return;
    }

    uint v_off    = t2 * input_size + h * p.head_size + 2u * output_size;
    uint dout_off = t  * output_size + h * p.head_size;

    float acc = 0.0;
    for (uint d = 0u; d < p.head_size; d++) {
        acc += qkv[v_off + d] * dout[dout_off + d];
    }
    pgrad[pg_off] = acc;
}
