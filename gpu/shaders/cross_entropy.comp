// Forward of `cross_entropy`. Mirrors CPU `cpu_cross_entropy_forward`:
//   probabilities[sample, i] = softmax(logits[sample, :])
//   loss[sample]             = -logits[sample, target] + max + log(sum_exp)
//
// One workgroup per sample row, BLOCK threads, two shared-memory reductions
// (max for stability, then sum for the softmax denominator), then a
// per-element write of probabilities. Targets are u32; CPU uploads them
// per-call into a HOST_VISIBLE staging buffer.
#version 450

#define BLOCK 256

layout(local_size_x = BLOCK) in;

layout(set = 0, binding = 0) readonly  buffer X    { float logits[]; };
layout(set = 0, binding = 1) readonly  buffer T    { uint  targets[]; };
layout(set = 0, binding = 2) writeonly buffer P    { float probs[];  };
layout(set = 0, binding = 3) writeonly buffer L    { float loss[];   };

layout(push_constant) uniform Params {
    uint count;
    uint class_size;
} p;

shared float s_max[BLOCK];
shared float s_sum[BLOCK];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= p.count) return;

    uint base = row * p.class_size;

    // Phase 1: per-row max for numerical stability.
    float local_max = -3.402823e38;
    for (uint i = tid; i < p.class_size; i += BLOCK) {
        float v = logits[base + i];
        if (v > local_max) local_max = v;
    }
    s_max[tid] = local_max;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_max[tid] = max(s_max[tid], s_max[tid + stride]);
        barrier();
    }
    float max_v = s_max[0];
    barrier();

    // Phase 2: sum of exp(logits - max). Stash exp-shifted values into
    // probs[] for now; we'll rescale by 1/sum in phase 3.
    float local_sum = 0.0;
    for (uint i = tid; i < p.class_size; i += BLOCK) {
        float e = exp(logits[base + i] - max_v);
        probs[base + i] = e;
        local_sum += e;
    }
    s_sum[tid] = local_sum;
    barrier();
    for (uint stride = BLOCK / 2u; stride > 0u; stride >>= 1) {
        if (tid < stride) s_sum[tid] += s_sum[tid + stride];
        barrier();
    }
    float exp_sum = s_sum[0];
    float inv_sum = exp_sum == 0.0 ? 0.0 : (1.0 / exp_sum);
    barrier();

    // Phase 3: normalize probabilities and write per-sample loss.
    for (uint i = tid; i < p.class_size; i += BLOCK) {
        probs[base + i] *= inv_sum;
    }

    if (tid == 0u) {
        uint target = targets[row];
        loss[row] = -logits[base + target] + max_v + log(exp_sum);
    }
}
